#!/usr/bin/env bash
set -euo pipefail

# headlong-slack-bridge — Slack Socket Mode bridge for a Headlong identity.
#
# Usage:
#   headlong-slack-bridge [ROOT] [--verbose]
#
# ROOT defaults to the headlong repo (parent of this script's directory).
# Requires uv. Configuration via env: SLACK_BOT_TOKEN, SLACK_APP_TOKEN,
# HEADLONG_SLACK_IDENTITY (defaults to the identity the `default`
# link points at), HEADLONG_WEB_URL (SHELLM_* names still honored as
# fallbacks).

# Resolve through symlinks (install.sh --symlinks puts this on PATH), then
# fall back to the checkout recorded by install.sh / headlong-init.
ROOT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ ! -d "$ROOT_DIR/slack" ]]; then
    _home="${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}"
    _rec=$(cat "$_home/app_dir" 2>/dev/null || true)
    if [[ -n "$_rec" && -d "$_rec/slack" ]]; then ROOT_DIR="$_rec"
    elif [[ -d "$_home/app/slack" ]]; then ROOT_DIR="$_home/app"
    else echo "headlong-slack-bridge: can't find the headlong checkout (slack/ missing); set HEADLONG_HOME or run from a checkout" >&2; exit 1
    fi
fi

# Headlong's env files, loaded the way tools/persona and bin/llm load them:
# what is already exported wins, so systemd's EnvironmentFile and `slack run`
# still take precedence. Without this the bridge is the only entry point that
# cannot see the checkout's .env, and a token that lives there reads as absent.
_load_env() {
    local envfile="$1"
    [[ -f "$envfile" ]] || return 1
    local key val
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        [[ -n "${!key+x}" ]] && continue
        # shellcheck disable=SC1090  # sourcing the user's own env file
        val=$(set +e; set -a; . "$envfile" >/dev/null 2>&1; if [[ -n "${!key+x}" ]]; then printf '%s' "${!key}"; else exit 1; fi) || { printf '%s: warning: could not read %s from %s; ignoring it\n' "${0##*/}" "$key" "$envfile" >&2; continue; }
        export "$key=$val"
    done < <(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\2/p' "$envfile")
    return 0
}
_load_env "$ROOT_DIR/.env" || true
_load_env "${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}/.env" || true

command -v uv >/dev/null 2>&1 || { echo "headlong-slack-bridge: uv is required (https://docs.astral.sh/uv/)" >&2; exit 1; }

# First arg is ROOT if it isn't a flag; all remaining args pass through.
if [[ $# -gt 0 && "${1:0:1}" != "-" ]]; then
    serve_root="$1"
    shift
else
    serve_root="$ROOT_DIR"
fi

exec uv run --project "$ROOT_DIR/slack" headlong-slack-bridge "$serve_root" "$@"
