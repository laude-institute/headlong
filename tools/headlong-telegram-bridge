#!/usr/bin/env bash
set -euo pipefail

# headlong-telegram-bridge — Telegram Bot API bridge for a Headlong identity.
#
# Usage:
#   headlong-telegram-bridge [ROOT] [--verbose]
#
# ROOT defaults to the headlong repo (parent of this script's directory).
# Requires uv. Configuration via env: TELEGRAM_BOT_TOKEN, TELEGRAM_ADMIN_ID,
# HEADLONG_TELEGRAM_IDENTITY (defaults to the identity the `default`
# link points at), HEADLONG_WEB_URL (SHELLM_* names still honored as
# fallbacks).
#
# Note: the production systemd unit does NOT use this script — it execs the
# project venv directly so the bridge can run as its own user (uv would try
# to write the service-owned venv). This launcher is for local dev.

# Resolve through symlinks (install.sh --symlinks puts this on PATH), then
# fall back to the checkout recorded by install.sh / headlong-init.
ROOT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ ! -d "$ROOT_DIR/telegram" ]]; then
    _home="${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}"
    _rec=$(cat "$_home/app_dir" 2>/dev/null || true)
    if [[ -n "$_rec" && -d "$_rec/telegram" ]]; then ROOT_DIR="$_rec"
    elif [[ -d "$_home/app/telegram" ]]; then ROOT_DIR="$_home/app"
    else echo "headlong-telegram-bridge: can't find the headlong checkout (telegram/ missing); set HEADLONG_HOME or run from a checkout" >&2; exit 1
    fi
fi

# Headlong's env files, loaded the way tools/persona and bin/llm load them:
# what is already exported wins, so the production unit's root-owned
# /etc/shellm/telegram.env (which does not use this launcher at all) stays
# authoritative where it exists. Without this the bridge is the only entry
# point that cannot see the checkout's .env, and a token that lives there
# reads as absent. Loading sources the checkout's .env, so this launcher is
# for local dev, not for the token-holding service user.
_load_env() {
    local envfile="$1"
    [[ -f "$envfile" ]] || return 1
    local key val
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        [[ -n "${!key+x}" ]] && continue
        # shellcheck disable=SC1090  # sourcing the user's own env file
        val=$(set +e; set -a; . "$envfile" >/dev/null 2>&1; if [[ -n "${!key+x}" ]]; then printf '%s' "${!key}"; else exit 1; fi) || { printf '%s: warning: could not read %s from %s; ignoring it\n' "${0##*/}" "$key" "$envfile" >&2; continue; }
        export "$key=$val"
    done < <(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\2/p' "$envfile")
    return 0
}
_load_env "$ROOT_DIR/.env" || true
_load_env "${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}/.env" || true

command -v uv >/dev/null 2>&1 || { echo "headlong-telegram-bridge: uv is required (https://docs.astral.sh/uv/)" >&2; exit 1; }

# First arg is ROOT if it isn't a flag; all remaining args pass through.
if [[ $# -gt 0 && "${1:0:1}" != "-" ]]; then
    serve_root="$1"
    shift
else
    serve_root="$ROOT_DIR"
fi

exec uv run --project "$ROOT_DIR/telegram" headlong-telegram-bridge "$serve_root" "$@"
