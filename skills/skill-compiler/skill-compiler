synthesize_tests() {
    local spec_json="$1"
    local teacher_model="${2:-}"
    local num_tests="${3:-8}"
    local skill_abs="${4:-}"
    local phrase_pool="${5:-}"
    if [[ -z "$phrase_pool" ]]; then
        phrase_pool="[]"
        if [[ -n "$skill_abs" && -d "$skill_abs" ]]; then
            phrase_pool=$(capture_phrase_pool "$skill_abs" || printf '[]')
        fi
    fi

    local skill_spec
    skill_spec=$(printf '%s' "$spec_json" | _sc_jq -c .)
    # Tell the teacher which declared binaries the
    # test environment has (the dependency rule). A test that needs a missing binary dies at
    # exit 127 and the stall guard kills the run before any expected line.
    local bins_status="none declared"
    local declared_bin
    declared_bin=$(printf '%s' "$spec_json" | _sc_jq -r '[.bins[]?] | join(" ")')
    if [[ -n "$declared_bin" ]]; then
        local -a bin_arr=()
        local b
        read -r -a bin_arr <<< "$declared_bin"
        bins_status=""
        for b in "${bin_arr[@]}"; do
            if command -v "$b" >/dev/null 2>&1; then
                bins_status="${bins_status}${b}: installed"$'\n'
            else
                bins_status="${bins_status}${b}: NOT INSTALLED"$'\n'
            fi
        done
        bins_status="${bins_status%$'\n'}"
    fi



    # Keep the teacher template literal; substitutions below carry the inputs.
    local prompt
    prompt=$(cat <<'PROMPT_EOF'
Generate validation cases for a Headlong skill. Skills are procedural SKILL.md
files loaded with skills show; they are not automatically executable commands.
Return only a JSON array with __NUM_TESTS__ objects. Each has name, prompt,
expect (final, observation, shell-output, or error), and expect_contains (strings).
Every case requires a successful runner. final needs an answer; observation and
shell-output need their named output, without requiring a final answer. error
means a recorded command failure, never a provider outage or runner failure.

Use the specification and usage syntax exactly. Build all required fixtures in
the test workdir. For git tasks create a new repository in a subdirectory, stage
and commit files before requiring a clean tree. Never read live stores or message
humans. Invoke shipped scripts at their absolute path: __SKILL_ABS__/<file>.
For reference skills ask a direct question answered from the provided skill text.
For tool skills ask for the result as plain text in the final answer, not output
pasted into executable code blocks.

Copy expected phrases verbatim from the phrase pool. Prefer diagnostic output
phrases over bare words; use stable fragments rather than variable counts. A
clean case must expect the all-clear phrase, not a bare error/violation word.
Do not expect fixture data echoed from the prompt, a file, or command text.
Leave expect_contains empty if no pool phrase fits; this checks the terminal
step only and cannot provide literal attestation or prove behavior quality.
1. PROMPT-EXPECT AGREEMENT: require only output the requested task can produce.
2. NO PLACEHOLDER SCAFFOLDING: never expect example slot names.
3. EXPECT THE OUTPUT NOT THE COMMAND: do not pin command spelling or quotes.
4. DEPENDENCY: avoid absent binaries or test a documented graceful failure.

SKILL SPECIFICATION (JSON):
__SKILL_SPEC__

PHRASE POOL (verbatim vocabulary, not a claim of behavioral coverage):
__PHRASE_POOL__

BINARIES THIS SKILL DECLARES, AND WHETHER THE TEST ENVIRONMENT HAS THEM:
__BINS_STATUS__
PROMPT_EOF
)
    # One callback pass over the original template: replacement data is literal
    # on Bash 3.2 and 5.2, and placeholder-looking input is never expanded again.
    local replacements="$TMPDIR/teacher-inputs.json"
    _sc_jq -n --arg spec "$skill_spec" --arg pool "$phrase_pool" --arg bins "$bins_status" \
        --arg num "$num_tests" --arg path "${skill_abs:-$SKILLS_DIR}" \
        '{__SKILL_SPEC__:$spec, __PHRASE_POOL__:$pool, __BINS_STATUS__:$bins, __NUM_TESTS__:$num, __SKILL_ABS__:$path}' > "$replacements"
    prompt=$(printf '%s' "$prompt" | python3 -c '
import json,re,sys
values=json.load(open(sys.argv[1]))
print(re.sub("|".join(map(re.escape,values)), lambda m: values[m[0]], sys.stdin.read()),end="")
' "$replacements")

    local -a teacher_args=()
    [[ -z "$teacher_model" ]] || teacher_args=(-m "$teacher_model")
    local tests_json llm_rc attempt
    for attempt in 1 2 3 4; do
        llm_err_file="${TMPDIR:-/tmp}/teacher-stderr.$$"
        if tests_json=$(printf '%s' "$prompt" | llm ${teacher_args[@]+"${teacher_args[@]}"} 2>"$llm_err_file"); then llm_rc=0; else llm_rc=$?; fi
        [ "$llm_rc" -eq 0 ] && [ -n "$tests_json" ] && break
        [[ "$attempt" -eq 4 ]] || sleep $((attempt * 5))
    done
    [ "$llm_rc" -eq 0 ] || die "Teacher model call failed (rc=$llm_rc, model=${teacher_model:-llm configured default}): ${tests_json:0:500} stderr: $(head -c 300 "$llm_err_file" 2>/dev/null)"
    [ -n "$tests_json" ] || die "Teacher model returned empty output (model=${teacher_model:-llm configured default})"

    # Extract JSON array from response (handle potential markdown fences)
    extracted=$(printf '%s' "$tests_json" | python3 -c '
import sys,json
s = sys.stdin.read()
i = s.find(chr(91))
if i < 0: raise SystemExit
obj, _ = json.JSONDecoder().raw_decode(s[i:])
print(json.dumps(obj))
' 2>/dev/null) || extracted=""
    [ -n "$extracted" ] && tests_json="$extracted"

    # Validate JSON
    printf '%s' "$tests_json" | _sc_jq -e '
        type == "array" and length > 0 and all(.[];
          type == "object" and (.name | type == "string") and (.prompt | type == "string")
          and (.expect == "final" or .expect == "observation" or .expect == "shell-output" or .expect == "error")
          and ((.expect_contains // []) | type == "array" and all(.[]; type == "string")))
    ' >/dev/null || die "Teacher returned invalid test cases"

    # The requested count is a budget ceiling, even if the teacher returns more.
    printf '%s' "$tests_json" | _sc_jq --argjson n "$num_tests" '.[:$n]'
}

# Execute a single test case
# A probe gets a real wall-clock limit on both supported platforms.
_sc_bounded() {
    python3 - "$@" <<'PY'
import os, signal, subprocess, sys
p = subprocess.Popen(sys.argv[2:], start_new_session=True, stdin=subprocess.DEVNULL)
try:
    rc = p.wait(timeout=float(sys.argv[1]))
except subprocess.TimeoutExpired:
    rc = 124
finally:
    # A normally exiting parent may leave children holding the pipeline open.
    # Always retire the entire probe group before returning its status.
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    p.wait()
raise SystemExit(rc)
PY
}

execute_test() {
    local test_json="$1"
    local skill_name="$2"
    local max_iterations="${3:-15}"

    local test_name prompt expect expect_contains
    test_name=$(printf '%s' "$test_json" | _sc_jq -r '.name')
    prompt=$(printf '%s' "$test_json" | _sc_jq -r '.prompt')
    # Deterministic fallback: rewrite relative skill paths to absolute so the
    # checker script resolves even if the teacher used a relative path.
    prompt=$(printf '%s' "$prompt" | python3 -c '
import re,sys
root=sys.argv[1].rstrip("/") + "/"
print(re.sub(r"(?<![/A-Za-z0-9_.-])skills/", lambda m:root, sys.stdin.read()), end="")
' "$SKILLS_DIR")
    expect=$(printf '%s' "$test_json" | _sc_jq -r '.expect')
    expect_contains=$(printf '%s' "$test_json" | _sc_jq -c '.expect_contains // []')
    # Never weaken the teacher's assertions to obtain a pass. A clean case
    # requesting a bare violation term must fail the denial-aware matcher.

    info "Executing test: $test_name" >&2

    local test_traj_id
    test_traj_id="test-$(uuidgen 2>/dev/null || printf 'test-%s-%s' "$$" "$RANDOM")"

    # Fresh per-test run dir under a known-good scratch path. The old mktemp -d
    # inherited TMPDIR; when TMPDIR pointed at a stale path mktemp failed, the
    # rundir came out empty, and mkdir hit /traj, so every test died in harness
    # setup before the skill ever ran.
    local runs_base="${SC_RUNS_BASE:-$SC_SCRATCH/runs-data}"
    mkdir -p "$runs_base" || die "cannot create runs base: $runs_base"
    local rundir="$runs_base/$test_traj_id"
    local traj_dir="$rundir/traj"
    mkdir -p "$traj_dir" || die "cannot create rundir: $rundir"
    printf '%s\n' "$rundir" >> "$SC_SCRATCH/runs"
    export TMPDIR="$rundir"

    _sc_load_operator_config
    export SKILLS_DIR="$SKILLS_DIR"
    export SKILLS_KERNEL_DIR="$KERNEL_DIR"
    _sc_isolate_state "$rundir" || die "cannot create test state: $rundir"
    export SHELLM_RUN_ID_OUT="$rundir/root-run-id"

    # Get skills prompt to include in the test
    local skills_prompt
    skills_prompt=$(skills prompt 2>/dev/null || echo "")

    # For reference skills, pre-load the skill content so the agent can answer directly
    local skill_content=""
    local skill_path="${SKILLS_DIR}/${skill_name}/SKILL.md"
    if [[ -f "$skill_path" ]]; then
        skill_content=$(cat "$skill_path")
    elif [[ -f "${KERNEL_DIR}/${skill_name}/SKILL.md" ]]; then
        skill_content=$(cat "${KERNEL_DIR}/${skill_name}/SKILL.md")
    fi

    local full_prompt="${skills_prompt}

${prompt}"
    if [[ -n "$skill_content" ]]; then
        full_prompt="${full_prompt}

---

**Skill content for ${skill_name} (pre-loaded for reference):**
${skill_content}"
    fi

    # Run shellm
    local rc=0
    printf '%s' "$full_prompt" > "$rundir/prompt.txt"
    ( cd "$rundir" && shellm --max-iterations "$max_iterations" --workdir "$rundir" --prompt-file "$rundir/prompt.txt" ) >"$rundir/runner.stdout" 2>"$rundir/runner.stderr" || rc=$?

    # shellm creates a new trajectory ID. Its launcher handshake identifies the
    # actual run header; a child's final or another run's rows are never evidence.
    local actual_traj_file="$rundir/root-evidence.jsonl" harness_error=""
    if ! python3 - "$traj_dir" "$SHELLM_RUN_ID_OUT" "$actual_traj_file" 2>"$rundir/selection.stderr" <<'PY_ROOT'
import json, pathlib, sys
root, id_path, out = map(pathlib.Path, sys.argv[1:])
try:
    run_id = id_path.read_text().strip()
    if not run_id: raise ValueError("missing root run ID")
    matches = []
    for p in sorted(root.rglob("*")):
        if not p.is_file() or p.suffix not in (".jsonl", ".json"): continue
        with p.open() as f:
            try: meta = json.loads(next(f))
            except (ValueError, StopIteration): continue
            if not isinstance(meta, dict) or meta.get("type") != "trajectory": continue
            if meta.get("parent_traj") or meta.get("parent"): continue
            rows = [json.loads(line) for line in f if line.strip()]
        if any(r.get("type") == "shellm-run" and r.get("step_id") == run_id for r in rows):
            matches.append([r for r in rows if r.get("run_id") == run_id])
    if len(matches) != 1: raise ValueError("expected exactly one root trajectory for launched run")
    with out.open("w") as f:
        for r in matches[0]: f.write(json.dumps(r) + "\n")
except (OSError, ValueError, TypeError, AttributeError) as e:
    raise SystemExit("cannot select root run: " + str(e))
PY_ROOT
    then
        harness_error=$(cat "$rundir/selection.stderr")
        : > "$actual_traj_file"
    fi
    [[ "$rc" -eq 0 ]] || harness_error="shellm runner failed (exit $rc)${harness_error:+; $harness_error}"
    local runner_stderr
    runner_stderr=$(head -c 2000 "$rundir/runner.stderr")
    local last_step_type last_step_content final_content
    last_step_type=$(_sc_jq -rs 'last.type // ""' "$actual_traj_file")
    last_step_content=$(_sc_jq -rs 'last.content // ""' "$actual_traj_file")
    final_content=$(_sc_jq -rs '[.[] | select(.type=="final") | .content // .details // ""] | last // ""' "$actual_traj_file")

    # Every expectation requires a successful runner. Error means a recorded
    # command failure, not a provider error or shellm stall. Non-final outcomes
    # require their named evidence and do not require a final answer.
    local pass=false final_len
    final_len=$(printf '%s' "$final_content" | tr -d '[:space:]' | wc -c | tr -d ' ')
    if [[ -z "$harness_error" ]]; then
        case "$expect" in
            final) [[ "$final_len" -eq 0 ]] || pass=true ;;
            observation|shell-output)
                if _sc_jq -se --arg type "$expect" 'any(.[]; .type==$type and
                    ([.content, .stdout, .stderr] | any(.[]; type=="string" and test("\\S"))))' "$actual_traj_file" >/dev/null; then pass=true; fi ;;
            error)
                if _sc_jq -se 'any(.[]; .type=="shell-output" and
                    (.exit | type=="number" and .!=0) and .timed_out!=true)' "$actual_traj_file" >/dev/null; then pass=true; fi ;;
        esac
    fi

    # Check expect_contains if provided and pass so far
# PROMPT-TERM-FIX 2026-09-22
        # FINAL-EVIDENCE-FIX 2026-09-22: the agent answer is evidence too.
        # expect_contains used to scan only tool output, so an expect=final test
        # whose term appears in the final answer could never pass (hello-world
        # false-fail). Final steps are in the evidence pool now, still subject to
        # the echo filter and the denial-aware matching below.
    local ec_matched=0 ec_missed='[]' ec_unchecked="$expect_contains"
    if [[ $pass == true ]] && [[ $(printf '%s' "$expect_contains" | _sc_jq 'length') -gt 0 ]]; then
        pass=false
        ec_unchecked='[]'
        local exec_content=""
        if [[ -n "$actual_traj_file" && -f "$actual_traj_file" ]]; then
            exec_content=$(_sc_jq -rs '[.[] | select(.type=="shell-output" or .type=="observation" or .type=="final") | (if .type=="shell-output" then ([.stdout // .content // "", .stderr // ""] | join("\n")) else (.content // .details // "") end)] | join("\n")' "$actual_traj_file" 2>/dev/null || true)
        fi
        local fixture_rows=""
        if [[ -d "$rundir" ]]; then
            fixture_rows=$(find "$rundir" -type f ! -path "$traj_dir/*" ! -path '*/memories/*' ! -name 'echo-filter*' ! -name 'root-evidence.jsonl' ! -name 'prompt.txt' ! -name 'runner.*' -print0 2>/dev/null | xargs -0 grep -hE '^[[:space:]]*[{\[]' 2>/dev/null || true)
        fi
        local exec_filter_file="${TMPDIR:-/tmp}/echo-filter-exec.$$"
        local command_rows
        command_rows=$(_sc_jq -rs '[.[] | .cmd? | select(type=="string")] | join("\n")' "$actual_traj_file")
        # Documentation is vocabulary, not an echo exclusion: genuine tool
        # output may use the documented phrase. Exclude task/command echoes.
        printf '%s\n%s\n%s\n' "$prompt" "$command_rows" "$fixture_rows" | sed '/^[[:space:]]*$/d' > "$exec_filter_file"
        exec_content=$(printf '%s\n' "$exec_content" | _sc_subtract_lines "$exec_filter_file")
        # Files in the workdir may be inputs, source, or invented notes.
        # Only trajectory output and answers are assertion evidence.
        rm -f "$exec_filter_file"
        # DENIAL-FIX 2026-09-22: a line that denies the term ("No violations
        # found", "Not a violation", "0 violations") is evidence of absence, not
        # of the term.
        # DENIAL-AWARE-FIX 2026-09-22: the all-clear line ("No violations found")
        # must stay visible to terms that are themselves denial phrases ("No
        # violations") or clean cases could never pass, and a bare term
        # ("violation") must never ride on that line or a clean run would satisfy
        # a detection test. So denial lines are split out and matched only for
        # denial-shaped terms, and a decoration prefix ("✓ ", "✗ ") is ignored
        # when classifying a line as denial.
        local denial_re='^[^[:alnum:]]*(no|not|never|nothing|none|without|clean|zero|0)([[:space:]]|:|$)'
        local exec_match
        exec_match=$(printf '%s\n' "$exec_content" | grep -Eiv -- "$denial_re" 2>/dev/null || true)
        local exec_denial
        exec_denial=$(printf '%s\n' "$exec_content" | grep -Ei -- "$denial_re" 2>/dev/null || true)
        local i=0
        local len
        len=$(printf '%s' "$expect_contains" | _sc_jq 'length')
        while [[ $i -lt $len ]]; do
            local lit_hit=false
            local substr
            substr=$(printf '%s' "$expect_contains" | _sc_jq -r ".[$i]")
            # WORD-FIX 2026-09-22: whole-word fixed-string matching. "violation"
            # no longer rides on "violations" and "verif" no longer rides on
            # "verification"; regex metacharacters in terms are literal now.
            # STEM-FIX 2026-09-22: a singular term may match its plain plural
            # (violation -> violations, via optional s/es), nothing longer. A
            # partial term like "verif" still cannot ride on "verification".
            # GLUE-FIX 2026-09-22: a multi-word phrase is matched as a literal
            # substring, because output that strips HTML glues the phrase to the
            # next text ("Example Domainbody{...}") and a whole-word boundary
            # then fails on every occurrence. Single words keep whole-word
            # matching so "violation" cannot ride on "violations".
            if [[ "$substr" == *" "* ]]; then
                if printf '%s\n' "$exec_match" | _phrase_match "$substr"; then
                    lit_hit=true
                fi
            elif printf '%s\n' "$exec_match" | _word_match "$substr"; then
                lit_hit=true
            fi
            # QUOTE-FOLD-FIX 2026-09-27: the same command written with the other
            # quote style is the same command (single-quote and double-quote
            # spellings of one sed strip produce identical output, verified
            # 2026-09-27). Fold both quote characters to one before matching a
            # quoted literal so one spelling is not brittle against the other.
            if [[ "$substr" == *"'"* || "$substr" == *'"'* ]]; then
                local fold_lit fold_ev
                fold_lit=$(printf '%s' "$substr" | sed "s/[\'\"]/'/g")
                fold_ev=$(printf '%s\n' "$exec_match" | sed "s/[\'\"]/'/g")
                if printf '%s\n' "$fold_ev" | _phrase_match "$fold_lit"; then
                    lit_hit=true
                fi
            fi
            # DENIAL-AWARE-FIX 2026-09-22: a denial line may only satisfy a term
            # that is itself a denial phrase, so "No violations found" still
            # proves a clean case while a bare "violation" cannot ride on it.
            if printf '%s' "$substr" | grep -Eiq -- "$denial_re"; then
                if [[ "$substr" == *" "* ]]; then
                    if printf '%s\n' "$exec_denial" | _phrase_match "$substr"; then
                        lit_hit=true
                    fi
                elif printf '%s\n' "$exec_denial" | _word_match "$substr"; then
                    lit_hit=true
                fi
            fi
            if [[ "$lit_hit" == true ]]; then
                ec_matched=$((ec_matched + 1))
            else
                ec_missed=$(printf '%s' "$ec_missed" | _sc_jq --arg lit "$substr" '. + [$lit]')
            fi
            i=$((i + 1))
        done
        if [[ $ec_matched -eq $len ]]; then
            pass=true
        fi
    fi

    # Build result JSON - use --arg for strings to avoid JSON parsing issues
    local test_json_escaped
    test_json_escaped=$(printf '%s' "$test_json" | _sc_jq -c .)

    _sc_jq -n \
        --argjson test "$test_json_escaped" \
        --arg pass "$pass" \
        --arg last_step_type "$last_step_type" \
        --arg last_step_content "$last_step_content" \
        --arg final "$final_content" \
        --arg exit_code "$rc" \
        --arg ec_matched "$ec_matched" \
        --argjson ec_missed "$ec_missed" --argjson ec_unchecked "$ec_unchecked" \
        --arg harness_error "$harness_error" --arg runner_stderr "$runner_stderr" \
        --arg final_len "$final_len" \
        '{test:$test, pass:($pass=="true"), last_step_type:$last_step_type, last_step_content:$last_step_content, final:$final, exit_code:($exit_code|tonumber), expect_contains_matched:($ec_matched|tonumber), expect_contains_missed:$ec_missed, expect_contains_unchecked:$ec_unchecked, final_len:($final_len|tonumber), runner_stderr:$runner_stderr} + (if $harness_error=="" then {} else {harness_error:$harness_error} end)'
}

# Write cache files
write_cache() {
    local skill_name="$1"
    local results_json="$2"
    local phrase_pool="${3:-[]}"
    # LITERAL-SOURCE 2026-09-27: the copy of the skill the tests execute, so the
    # attestation site of every literal is classified against the same text the
    # tests ran against (SKILLS_DIR copy first, then the kernel copy).
    local skill_dir="${4:-}"

    local total passed
    total=$(printf '%s' "$results_json" | _sc_jq 'length')
    passed=$(printf '%s' "$results_json" | _sc_jq '[.[] | select(.pass == true)] | length')

    # PASS-VERIFICATION 2026-09-27: a green run counts as verified only when
    # every expect_contains literal it rests on is POOL-EXACT in the phrase pool
    # the teacher was handed. An INVENTED literal can match because the test
    # prompt forced the phrase into the output, so it proves nothing about the
    # tool's own vocabulary and must not ride on a pass.
    # FRAGMENT-ATTEST 2026-09-27: verified used to be recomputed here with a
    # second, stricter rule (whole-pool membership only), which disagreed with
    # the literal labeler below and undercounted fragment-attested passes. One
    # rule now: the labeler writes the json summary, and verified is read back
    # from it after that block runs.
    local verified=0

    # JSON cache
    # POOL-PROVENANCE 2026-09-27: label every expect_contains literal against the
    # phrase pool the teacher was actually handed. POOL-EXACT = verbatim in the
    # pool; INVENTED = unverified vocabulary the pool never guaranteed.
    # PROVENANCE-FIX 2026-10-02 (fold of c8966f7): TOOL-OUTPUT is the only
    # literal source that is occurrence evidence, so it needs captured real tool
    # output to check against. The harvested history pool is that corpus;
    # SKILL_REAL_OUTPUT and SKILL_HISTORY_POOL win when set, and with no corpus
    # loaded a print-line string stays SCRIPT-PRINT instead of being vouched for.
    local real_out_src="${SKILL_REAL_OUTPUT:-${SKILL_HISTORY_POOL:-}}"
    if [[ -z "$real_out_src" && "${SKILL_AUTO_HARVEST:-1}" != "0" ]]; then
        real_out_src=$(harvest_history_pool "$skill_dir" || true)
    fi
    [[ -n "$real_out_src" && -f "$real_out_src" ]] || real_out_src=""
    local prov_summary
    prov_summary=$(
        skill_name="$skill_name"
        printf '%s' "$phrase_pool" > "$TMPDIR/cache-pool.json"
        printf '%s' "$results_json" > "$TMPDIR/cache-results.json"
        phrase_pool_file="$TMPDIR/cache-pool.json"
        results_json_file="$TMPDIR/cache-results.json"
        json_out="$COMPILED_DIR/${skill_name}.json"
        skill_dir="$skill_dir"
        poolcap_json_path="${COMPILED_DIR:-}/pool-$(basename "${skill_dir%/}").json"
        export skill_name phrase_pool_file results_json_file json_out skill_dir poolcap_json_path
        export SKILL_REAL_OUTPUT="${real_out_src:-}"
        python3 - <<'PY'
import os, json, re, glob
pool = json.load(open(os.environ["phrase_pool_file"]))
res = json.load(open(os.environ["results_json_file"]))
# POOL-CAP FIX 2026-10-02: the pool handed the teacher is the tail-truncated
# view of the harvested vocabulary, so a real phrase the cap dropped was labeled
# INVENTED, a false negative in the instrument's own reference frame. The pool
# file records the truncation, and a dropped-but-real literal gets its own
# provenance class instead of sharing one with invented vocabulary.
poolcap = {}
_pc = os.environ.get("poolcap_json_path") or ""
if _pc and os.path.isfile(_pc):
    try:
        poolcap = json.load(open(_pc))
    except Exception:
        poolcap = {}
pooldropped = set(poolcap.get("dropped") or [])
poolset = set(pool)

def label_literal(lit, pool, poolset):
    # POOL-EXACT = the literal is a whole pool entry, the vocabulary the teacher
    #   could copy verbatim.
    # POOL-FRAGMENT = the literal is a constant fragment of a pool entry: its
    #   vocabulary is attested by the skill's own output or docs even when the
    #   teacher split a line differently than the harvest did.
    # INVENTED = nowhere in the pool: unverified vocabulary.
    if lit in poolset:
        return "POOL-EXACT"
    if len(lit) >= 4 and any(lit in entry for entry in pool):
        return "POOL-FRAGMENT"
    if lit in pooldropped or (len(lit) >= 4 and any(lit in entry for entry in pooldropped)):
        return "POOL-DROPPED"
    return "INVENTED"

# LITERAL-SOURCE 2026-09-27: record WHERE each literal is attested in the
# skill's own text, so the strength of every assertion is visible in the cache
# itself instead of only in prose. Priority: a line one of the skill's own
# scripts prints, then other script text, then the metadata frontmatter, then
# documentation prose, then nowhere (UNATTESTED).
skill_dir = os.environ.get("skill_dir") or ""
_SCRIPT_PRINT_RE = re.compile(r"\b(print|echo|printf|append|write|say)\b")

_REAL_OUTPUT = None
_HAS_OUTPUT_CAPTURE = False

def _collect_strings(obj, out):
    if isinstance(obj, str):
        for ln in obj.splitlines():
            ln = ln.strip()
            if ln:
                out.add(ln)
    elif isinstance(obj, dict):
        # Harvest blobs contain descriptive metadata, not just stdout.
        for entry in obj.get("entries", []):
            if isinstance(entry, dict) and isinstance(entry.get("line"), str):
                _collect_strings(entry["line"], out)
    elif isinstance(obj, list):
        for v in obj:
            if isinstance(v, str): _collect_strings(v, out)

def real_output_corpus():
    """Captured real tool output lines, from SKILL_REAL_OUTPUT or SKILL_HISTORY_POOL."""
    global _REAL_OUTPUT, _HAS_OUTPUT_CAPTURE
    if _REAL_OUTPUT is not None:
        return _REAL_OUTPUT
    lines = set()
    for var in ("SKILL_REAL_OUTPUT", "SKILL_HISTORY_POOL"):
        f = os.environ.get(var, "")
        if not (f and os.path.isfile(f)):
            continue
        _HAS_OUTPUT_CAPTURE = True
        txt = open(f, errors="replace").read()
        dumped = False
        if f.endswith(".json") or txt.lstrip()[:1] in ("{", "["):
            try:
                _collect_strings(__import__("json").loads(txt), lines)
                dumped = True
            except Exception:
                dumped = False
        if not dumped:
            for ln in txt.splitlines():
                ln = ln.strip()
                if ln:
                    lines.add(ln)
    _REAL_OUTPUT = lines
    return lines

def classify_literal(lit):
    """Where an expected string comes from.

    TOOL-OUTPUT is the only occurrence evidence: the string is inside captured
    real tool output. Every other label only names where the string could have
    come from, so none of them vouches that the tool prints it.
    """
    if not lit:
        return "UNATTESTED"
    corpus = real_output_corpus()
    if any(lit in ln for ln in corpus):
        return "TOOL-OUTPUT"
    if not (skill_dir and os.path.isdir(skill_dir)):
        return "UNATTESTED"
    fm = ""
    sp = os.path.join(skill_dir, "SKILL.md")
    text = open(sp, errors="replace").read() if os.path.isfile(sp) else ""
    m = re.match(r"\A---\n(.*?)\n---\n", text, flags=re.S)
    if m:
        fm = m.group(1)
        body = text[m.end():]
    else:
        body = text
    seen_script = False
    for fn in sorted(glob.glob(os.path.join(skill_dir, "*.py")) + glob.glob(os.path.join(skill_dir, "*.sh"))):
        if ".bak" in os.path.basename(fn):
            continue
        for line in open(fn, errors="replace"):
            if lit in line:
                if _SCRIPT_PRINT_RE.search(line):
                    return "SCRIPT-PRINT-UNATTESTED" if _HAS_OUTPUT_CAPTURE else "SCRIPT-PRINT"
                seen_script = True
    if seen_script:
        return "SCRIPT-TEXT"
    if lit in body:
        return "DOC"
    if lit in fm:
        return "METADATA"
    return "UNATTESTED"

src_counts = {"TOOL-OUTPUT": 0, "SCRIPT-PRINT": 0, "SCRIPT-PRINT-UNATTESTED": 0, "SCRIPT-TEXT": 0, "DOC": 0, "METADATA": 0, "UNATTESTED": 0}
srclines = []

lines = []
inv = 0
exact = 0
frag = 0
dropped = 0
for r in res:
    t = r.get("test") or {}
    labels = {}
    sources = {}
    for lit in (t.get("expect_contains") or []):
        lab = label_literal(lit, pool, poolset)
        src = classify_literal(lit)
        labels[lit] = lab
        sources[lit] = src
        src_counts[src] = src_counts.get(src, 0) + 1
        srclines.append("- %s | %s | %s" % (t.get("name", ""), src, lit))
        if lab == "INVENTED":
            inv += 1
        elif lab == "POOL-FRAGMENT":
            frag += 1
        elif lab == "POOL-DROPPED":
            dropped += 1
        else:
            exact += 1
        lines.append("- %s | %s | %s" % (t.get("name", ""), lab, lit))
    r["literal_labels"] = labels
    r["literal_sources"] = sources
    if not r.get("pass"):
        r["verification"] = "FAIL"
    elif not labels:
        r["verification"] = "GREEN-NO-LITERALS"
    elif any(lab == "INVENTED" for lab in labels.values()):
        r["verification"] = "GREEN-ON-INVENTED"
    elif any(lab == "POOL-DROPPED" for lab in labels.values()):
        r["verification"] = "GREEN-ON-DROPPED"
    else:
        r["verification"] = "VERIFIED"
summary = dict(green_no_literals=sum(1 for r in res if r.get("verification") == "GREEN-NO-LITERALS"), skill=os.environ.get("skill_name", ""), total=len(res), passed=sum(1 for r in res if r.get("pass")), verified=sum(1 for r in res if r.get("verification") == "VERIFIED"), green_on_invented=sum(1 for r in res if r.get("verification") == "GREEN-ON-INVENTED"), fail=sum(1 for r in res if not r.get("pass")), literal_provenance=dict(pool_exact=exact, pool_fragment=frag, invented=inv, pool_dropped=dropped), literal_sources=dict(src_counts), green_on_dropped=sum(1 for r in res if r.get("verification") == "GREEN-ON-DROPPED"), pool_truncated=bool(poolcap.get("pool_dropped") or 0))
out = dict(summary=summary, tests=res)
open(os.environ["json_out"], "w").write(json.dumps(out, indent=2))
md = "\n## Literal provenance (expect_contains vs the phrase pool)\n\n"
md += "POOL-EXACT means a whole entry in the pool handed to the teacher. POOL-FRAGMENT means a constant fragment of a pool entry, vocabulary the skill's own output or docs carry. INVENTED means unverified. POOL-DROPPED means real tool vocabulary the pool cap dropped from the truncated pool: real, but not pool-attested.\n\n"
md += "\n".join(lines) + "\n"
md += "\n## Literal sources (where each literal is attested in the skill's own text)\n\n"
md += "TOOL-OUTPUT = the string is in captured real tool output (SKILL_REAL_OUTPUT or SKILL_HISTORY_POOL), the only label that is occurrence evidence. SCRIPT-PRINT-UNATTESTED = on a line a script prints but never seen in captured output. SCRIPT-PRINT = on a print line, with no captured output loaded to check against. SCRIPT-TEXT = in a script away from a print line. METADATA = the frontmatter. DOC = documentation prose. UNATTESTED = found nowhere in the skill's own text. Classified against the copy of the skill the tests execute.\n\n"
md += "\n".join(srclines) + "\n"
with open(os.environ["json_out"] + ".prov", "w") as fh:
    fh.write(md)
print("POOL-EXACT %d, POOL-FRAGMENT %d, POOL-DROPPED %d, INVENTED %d" % (exact, frag, dropped, inv))
print("SOURCES TOOL-OUTPUT %d, SCRIPT-PRINT %d, SCRIPT-PRINT-UNATTESTED %d, SCRIPT-TEXT %d, DOC %d, METADATA %d, UNATTESTED %d" % (src_counts["TOOL-OUTPUT"], src_counts["SCRIPT-PRINT"], src_counts["SCRIPT-PRINT-UNATTESTED"], src_counts["SCRIPT-TEXT"], src_counts["DOC"], src_counts["METADATA"], src_counts["UNATTESTED"]))
PY
)
    info "Literal provenance: ${prov_summary}"
    verified=$(_sc_jq -r '.summary.verified' "$COMPILED_DIR/${skill_name}.json")

    # Markdown cache
    {
        printf '# Compiled cache for %s\n\n' "$skill_name"
        printf '_Generated: %s UTC_\n\n' "$(date -u +'%Y-%m-%d %H:%M:%S')"
        printf '## Summary: %d / %d passed, %d / %d verified (a pass counts as verified only on pool-attested literals)\n\n' "$passed" "$total" "$verified" "$total"
        local i=0
        while [[ $i -lt $total ]]; do
            local r name p lt
            r=$(printf '%s' "$results_json" | _sc_jq -c ".[$i]")
            name=$(printf '%s' "$r" | _sc_jq -r '.test.name')
            p=$(printf '%s' "$r" | _sc_jq -r '.pass')
            lt=$(printf '%s' "$r" | _sc_jq -r '.last_step_type')
            if [[ "$p" == "true" ]]; then
                printf '### %s: ✓ PASS\n\n' "$name"
                printf 'Expected: %s | Got: "%s"\n\n' "$(printf '%s' "$r" | _sc_jq -r '.test.expect')" "$lt"
            else
                printf '### %s: ✗ FAIL\n\n' "$name"
                printf 'Expected: %s | Got: "%s"\n\n' "$(printf '%s' "$r" | _sc_jq -r '.test.expect')" "$lt"
            fi
            i=$((i + 1))
        done
    } > "$COMPILED_DIR/${skill_name}.md"
    if [[ -f "$COMPILED_DIR/${skill_name}.json.prov" ]]; then
        cat "$COMPILED_DIR/${skill_name}.json.prov" >> "$COMPILED_DIR/${skill_name}.md"
    fi


    {
        printf '\n## Pass verification\n\n'
        printf 'VERIFIED = green with only pool-attested literals (POOL-EXACT or POOL-FRAGMENT). GREEN-NO-LITERALS = green without literal assertions (not attested). GREEN-ON-INVENTED = green but resting on unverified vocabulary, so not counted as verified. POOL-DROPPED and GREEN-ON-DROPPED mark real vocabulary the pool cap dropped from the truncated pool: real, but not pool-attested, so not counted as verified either.\n\n'
        python3 - "$COMPILED_DIR/${skill_name}.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
for r in d.get("tests", []):
    print("- %s | %s" % ((r.get("test") or {}).get("name", "?"), r.get("verification", "?")))
PY
    } >> "$COMPILED_DIR/${skill_name}.md"

    info "Compiled $skill_name: $passed/$total passed, $verified/$total verified ($(_sc_jq -r '.summary.green_on_invented' "$COMPILED_DIR/$skill_name.json") green on invented, $(_sc_jq -r '.summary.green_on_dropped' "$COMPILED_DIR/$skill_name.json") green on dropped literals)"
}

# Main compile command
cmd_compile() {
    local skill_name="" teacher_model="" num_tests=8 max_iterations=15
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --skill) _sc_option_value "$@"; skill_name="$2"; shift 2 ;;
            --teacher-model) _sc_option_value "$@"; teacher_model="$2"; shift 2 ;;
            --num-tests) _sc_option_value "$@"; num_tests="$2"; shift 2 ;;
            --max-iterations) _sc_option_value "$@"; max_iterations="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [[ -n "$skill_name" ]] || die "--skill is required"

    _sc_positive_integer --num-tests "$num_tests"
    _sc_positive_integer --max-iterations "$max_iterations"
    # Normalize leading zeros without Bash arithmetic overflow/octal rules.
    num_tests=$(python3 -c 'import sys; print(int(sys.argv[1]))' "$num_tests")
    max_iterations=$(python3 -c 'import sys; print(int(sys.argv[1]))' "$max_iterations")

    local skill_dir
    skill_dir=$(resolve_skill "$skill_name") || return 1

    info "Compiling skill: $skill_name"

    local spec_json
    spec_json=$(parse_skill_spec "$skill_dir")

    local tests_json
    local phrase_pool
    phrase_pool=$(capture_phrase_pool "$skill_dir") || die "cannot capture phrase pool"
    tests_json=$(synthesize_tests "$spec_json" "$teacher_model" "$num_tests" "$skill_dir" "$phrase_pool")

    local test_count
    test_count=$(printf '%s' "$tests_json" | _sc_jq 'length')
    info "Synthesized $test_count test cases"

    local all_results="[]" harness_failed=0
    local i=0
    while [[ $i -lt $test_count ]]; do
        local test_json
        test_json=$(printf '%s' "$tests_json" | _sc_jq -c ".[$i]")
        info "Running test $((i+1))/$test_count: $(printf '%s' "$test_json" | _sc_jq -r '.name')"
        local result_json
        local test_rc
        set +e
        result_json=$(set -e; execute_test "$test_json" "$skill_name" "$max_iterations")
        test_rc=$?
        set -e
        if [[ "$test_rc" -ne 0 ]] || ! printf '%s' "$result_json" | _sc_jq -e 'type == "object" and has("pass")' >/dev/null 2>&1; then
            result_json=$(_sc_jq -n --argjson test "$test_json" '{test:$test, pass:false, harness_error:"test harness failed; see stderr", last_step_type:"error", final:""}')
            harness_failed=1
        fi
        if printf '%s' "$result_json" | _sc_jq -e 'has("harness_error")' >/dev/null; then harness_failed=1; fi
        info "Test result: $(printf '%s' "$result_json" | _sc_jq -r '.pass')"
        all_results=$(printf '%s' "$all_results" | _sc_jq --argjson r "$result_json" '. + [$r]')
        i=$((i + 1))
    done

    write_cache "$skill_name" "$all_results" "$phrase_pool" "$skill_dir"
    [[ "$harness_failed" -eq 0 ]]
}

# Show the phrase pool a compile hands the teacher (verification surface for
# PHRASE-POOL v2: the pool must carry the tool's real output literals).
