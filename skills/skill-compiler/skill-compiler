            *) die "Unknown option: $1" ;;
        esac
    done
    [[ -n "$skill_name" ]] || die "--skill is required"

    validate_skill_name "$skill_name"
    rm -f "$COMPILED_DIR/${skill_name}.md" "$COMPILED_DIR/${skill_name}.json" \
        "$COMPILED_DIR/${skill_name}.json.prov" "$COMPILED_DIR/pool-${skill_name}.json"
    info "Cleaned cache for $skill_name"
}

# Dispatch
case "${1:-}" in
    compile) shift; cmd_compile "$@" ;;
    list) cmd_list ;;
    pool) shift; cmd_pool "$@" ;;
    show) shift; cmd_show "$@" ;;
    clean) shift; cmd_clean "$@" ;;
    -h|--help|"") usage ;;
    *) die "Unknown command: $1 (try --help)" ;;
esac
