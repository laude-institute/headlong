#!/usr/bin/env bash
# sc_tmpdir_bootstrap
# sc_tmpdir_bootstrap v2: keep TMPDIR on durable scratch, never under the
# ephemeral /tmp/shellm-run.* tree. That tree is reaped when the wake that
# created it ends, and a compile running in tmux outlives its wake, so every
# later teacher request died at mktemp with a dead template dir.
SC_TMP_BASE="${SC_TMP_BASE:-${SHELLM_WORKDIR:-${HOME:-/tmp}}/scratch/sc-tmp}"
mkdir -p "$SC_TMP_BASE"
TMPDIR=$(mktemp -d "$SC_TMP_BASE/XXXXXX")
export TMPDIR
if [ -n "${SHELLM_RUNDIR:-}" ]; then mkdir -p "$SHELLM_RUNDIR/tmp" 2>/dev/null || true; fi
set -euo pipefail

# skill-compiler — Compile a skill specification into a validated, cached adapter
# by synthesizing test cases with a teacher model, executing them, and storing
# working few-shots as a compiled adjunct.

# Resolve our own directory without depending on realpath, which is not on
# stock macOS PATH (Homebrew coreutils installs it prefixed). Same idiom as
# bin/shellm: try realpath, fall back to the invocation path.
_sc_self=$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]:-$0}")
SCRIPT_DIR="$(cd "$(dirname "$_sc_self")" && pwd)"
COMPILED_DIR="$SCRIPT_DIR/.compiled"
if [[ -z "${SKILLS_DIR:-}" ]]; then
    for _sc_cand in "$SCRIPT_DIR/.." "${HOME:-/tmp}/.skills"; do
        if [[ -d "$_sc_cand" ]]; then SKILLS_DIR="$(cd "$_sc_cand" && pwd)"; break; fi
    done
    SKILLS_DIR="${SKILLS_DIR:-${HOME:-/tmp}/.skills}"
fi
KERNEL_DIR="${SKILLS_KERNEL_DIR:-$SCRIPT_DIR/../../kernel}"

mkdir -p "$COMPILED_DIR"

usage() {
    cat <<'USAGE'
skill-compiler — Compile a skill specification into a validated, cached adapter

Usage:
  skill-compiler compile --skill <name> [--teacher-model <model>] [--num-tests <n>]
  skill-compiler list
  skill-compiler pool --skill <name>
  skill-compiler show --skill <name>
  skill-compiler clean --skill <name>

Options:
  --skill NAME            Skill to compile (directory name under skills/ or kernel/)
  --teacher-model MODEL   Teacher model for test synthesis (default: nvidia/nemotron-3-ultra-550b-a55b)
  --num-tests N           Number of test cases to synthesize (default: 8)
  --max-iterations N      Max shellm iterations per test (default: 10)

Commands:
  compile                 Compile a skill
  list                    List compiled skills
  pool --skill NAME       Print the phrase pool a compile would hand the teacher
  show --skill NAME       Show compiled cache for a skill
  clean --skill NAME      Remove compiled cache for a skill
USAGE
}

info() { printf '[skill-compiler] %s\n' "$*"; }
die() { printf '[skill-compiler] ERROR: %s\n' "$*" >&2; exit 1; }

# STORE-ISOLATION 2026-09-22: skills we refuse to compile. Auth skills need
# credentials; side-effect skills write the live identity store or message
# humans; git-diff-summarizer has no runnable command for a test to execute.
COMPILE_SKIP_SKILLS="github-api telegram googleworkspace chat slack mem traj recap goal-review git-diff-summarizer"

assert_compile_allowed() {
    local skill_name=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --skill) skill_name="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    [[ -n "$skill_name" ]] || return 0
    if [[ " $COMPILE_SKIP_SKILLS " == *" $skill_name "* ]]; then
        die "skill $skill_name is on the compile skip-list (auth, live-store writes, messaging humans, or no runnable command)"
    fi
}

# Parse SKILL.md into JSON spec
parse_skill_spec() {
    local skill_dir="$1"
    local skill_file="$skill_dir/SKILL.md"
    [[ -f "$skill_file" ]] || die "SKILL.md not found in $skill_dir"

    local frontmatter body
    frontmatter=$(sed -n '1,/^---$/p' "$skill_file" | sed '1d;$d')
    body=$(sed -n '/^---$/,${//!p;}' "$skill_file" | sed '1d')

    local name description
    name=$(printf '%s' "$frontmatter" | grep '^name:' | sed 's/^name: *//' | tr -d '"')
    description=$(printf '%s' "$frontmatter" | grep '^description:' | sed 's/^description: *//' | tr -d '"')

    # Extract Usage section from body (between ## Usage and next ## or end)
    local usage_section=""
    if printf '%s' "$body" | grep -q '^## Usage'; then
        usage_section=$(printf '%s' "$body" | sed -n '/^## Usage$/,/^## /p' | sed '$d')
    fi

    # Check if skill has a CLI tool/command (Usage section with code blocks)
    local has_cli_tool=false
    if printf '%s' "$body" | grep -q '```bash'; then
        has_cli_tool=true
    fi

    # Check if skill is a reference/documentation skill (explains concepts)    # DEPENDENCY-FIX 2026-09-27: declared binaries, so the teacher can see which
    # ones the test environment actually has (rule 18).
    local bins_csv
    bins_csv=$(printf '%s\n' "$frontmatter" | awk '
        /^[A-Za-z_]*[Bb]ins:/ { sub(/^[^:]*:[[:space:]]*/, ""); grab = 1 }
        grab {
            if ($0 ~ /^[[:space:]]*$/) next
            if ($0 !~ /^[[:space:]]*(-|\[)/) { grab = 0; next }
            line = $0
            gsub(/[\[\]",:]/, " ", line)
            n = split(line, a, /[[:space:]]+/)
            for (i = 1; i <= n; i++)
                if (a[i] ~ /^[A-Za-z0-9._+][A-Za-z0-9._+-]*$/) printf "%s,", a[i]
        }
    ' | sed 's/,$//')


    local is_reference_skill=false
    if printf '%s' "$body" | grep -qiE '(reference|overview|architecture|how.*works|concept|design)'; then
        is_reference_skill=true
    fi

    jq -n         --arg name "$name"         --arg description "$description"         --arg body "$body"         --arg usage_section "$usage_section"         --arg has_cli_tool "$has_cli_tool"         --arg bins "$bins_csv"         --arg is_reference_skill "$is_reference_skill"         '{name:$name, description:$description, body:$body, usage_section:$usage_section, has_cli_tool:($has_cli_tool=="true"), is_reference_skill:($is_reference_skill=="true"), bins:([$bins|split(",")[]|select(length>0)])}'
}

# Synthesize test cases using teacher model
# DIGIT-GLUE-FIX 2026-09-22, matcher rule v2: a multi-word phrase matches as a
# literal substring (GLUE-FIX), but a phrase edge that is a digit must not be
# welded to another digit. So "5 tests passed" cannot ride on "15 tests passed",
# "test 2" cannot ride on "test 21", while letter welds like
# "Example Domainbody{...}" keep matching as GLUE-FIX requires and a clean
# occurrence later in the same text still wins. Single words keep whole-word
# matching via grep -w in the single-word branch.
_phrase_match() {
    local out
    out=$(PHRASE="$1" awk '
        BEGIN { p = ENVIRON["PHRASE"]; if (length(p) == 0) exit }
        {
            n = length(p); hay = $0; off = 0
            fw = substr(p, 1, 1); lw = substr(p, n, 1)
            while (1) {
                i = index(substr(hay, off + 1), p)
                if (i == 0) break
                s = off + i; e = s + n - 1
                prev = (s > 1) ? substr(hay, s - 1, 1) : ""
                nxt = substr(hay, e + 1, 1)
                okp = (fw !~ /[0-9]/ || prev !~ /[0-9]/)
                okn = (lw !~ /[0-9]/ || nxt !~ /[0-9]/)
                if (okp && okn) { found = 1; exit }
                off = s
            }
        }
        END { print (found ? "match" : "nomatch") }
    ')
    [[ "$out" == "match" ]]
}

