#!/usr/bin/env bash
set -euo pipefail

# thinkers/finance_critic/step
# Autonomous Finance Critic for live NetSuite / FP&A anomaly analysis and proactive Slack alerting.

THINKER_NAME="finance_critic"
SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"

# shellcheck disable=SC1091
source "$SCRIPT_DIR/../_lib/common.sh"
_require_env

THINK_MODEL="${FINANCE_CRITIC_MODEL:-${THINK_MODEL:-${SHELLM_MODEL:-claude-sonnet-4-6}}}"
THINK_CONTEXT_TAIL="${FINANCE_CONTEXT_TAIL:-15}"

run_dir="$IDENTITY_DIR/workdir"
mkdir -p "$run_dir"

state_dir="$IDENTITY_DIR/run"
mkdir -p "$state_dir"
state_file="$state_dir/finance_critic_backoff_state.json"
wake_at_file="$state_dir/$THINKER_NAME.wake_at"

BACKOFF_BASE="${FINANCE_BACKOFF_BASE:-5}"
BACKOFF_FACTOR="${FINANCE_BACKOFF_FACTOR:-2}"
BACKOFF_CAP="${FINANCE_BACKOFF_CAP:-300}"

_delay_for_level() {
    local lvl="$1" d="$BACKOFF_BASE" i=1
    (( lvl <= 0 )) && { printf '0'; return; }
    while (( i < lvl )); do
        d=$(( d * BACKOFF_FACTOR ))
        (( d >= BACKOFF_CAP )) && { d="$BACKOFF_CAP"; break; }
        i=$(( i + 1 ))
    done
    (( d > BACKOFF_CAP )) && d="$BACKOFF_CAP"
    printf '%s' "$d"
}

_arm_wake() {
    local delay="$1"
    local now target
    now=$(date +%s)
    target=$(( now + delay ))
    printf '%s' "$target" > "$wake_at_file"
}

trap '_arm_wake "$(_delay_for_level 1)"' EXIT

# Read recent context using traj tail
recent_steps=$(traj tail -n "$THINK_CONTEXT_TAIL" -a --raw 2>/dev/null || true)

# System prompt for finance analysis
sys_prompt="You are the Finance Critic for $IDENTITY_NAME.
Analyze the following recent trajectory log of finance queries and NetSuite ERP tool outputs.
Determine if there are actionable financial insights, anomalies, cut-off discrepancies, unapplied receipts, or proactive reports worth alerting the team on Slack.

Format your response as valid JSON with:
{
  \"decision\": \"alert\" | \"idle\",
  \"reason\": \"One sentence explanation of what you observed\",
  \"alert_message\": \"Short, crisp Slack alert citing exact entities, GL accounts, dates, and amounts (or null if idle)\"
}
Only output the raw JSON object, no markdown fencing."

# Call Headlong's internal LLM driver (bin/llm)
llm_out=$(printf '%s\n\nRecent Trajectory Stream:\n%s\n' "$sys_prompt" "$recent_steps" | llm -m "$THINK_MODEL" --no-stream 2>/dev/null || true)

# Clean and parse JSON
decision=$(printf '%s' "$llm_out" | jq -r '.decision // "idle"' 2>/dev/null || echo "idle")
reason=$(printf '%s' "$llm_out" | jq -r '.reason // "no anomaly"' 2>/dev/null || echo "no anomaly")
alert_msg=$(printf '%s' "$llm_out" | jq -r '.alert_message // empty' 2>/dev/null || true)

if [[ "$decision" == "alert" && -n "$alert_msg" ]]; then
    today=$(date +%Y-%m-%d-%H%M)
    # Post alert to Slack channel C0CK170A7K7
    if [[ -f "$IDENTITY_DIR/.env.slack" ]]; then
        # shellcheck disable=SC1090
        source "$IDENTITY_DIR/.env.slack"
    fi

    if [[ -n "${SLACK_BOT_TOKEN:-}" ]]; then
        python3 -c "
import urllib.request, json, os
token = os.environ.get('SLACK_BOT_TOKEN')
channel = 'C0CK170A7K7'
msg = '''$alert_msg'''
req = urllib.request.Request(
    'https://slack.com/api/chat.postMessage',
    data=json.dumps({'channel': channel, 'text': msg, 'unfurl_links': False}).encode(),
    headers={'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'}
)
urllib.request.urlopen(req)
" 2>/dev/null || true
    fi

    traj append --field type=observation --field content="Delivered proactive finance insight: $reason" --field source="$THINKER_NAME"
    _arm_wake 300
    exit 0
fi

# Idle path
traj append --field type=idle --field content="idle - $reason" --field source="$THINKER_NAME"
_arm_wake "$BACKOFF_BASE"
exit 0
