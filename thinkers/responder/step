#!/usr/bin/env bash
set -euo pipefail

# responder/step — Immediate chat reply thinker.
#
# Fires on every inbound message: composes and sends a reply with a single
# llm call + `chat reply`. No shellm agentic loop, no tools — lowest
# possible latency. Idempotency comes from the reply itself (the reply_to
# stamp), from our decision observations, and from a reply_claim only
# while it is FRESH — a stale claim (crashed or failed send) deliberately
# never blocks the retry on redelivery. See the predicate below.

THINKER_NAME="responder"
SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"

# shellcheck disable=SC1091
source "$SCRIPT_DIR/../_lib/common.sh"

_require_env

THINK_MODEL="${THINK_MODEL:-${SHELLM_MODEL:-claude-opus-4-7}}"
THINK_CONTEXT_TAIL="${THINK_CONTEXT_TAIL:-20}"
REPLY_MODEL="${MONOLITH_REPLY_MODEL:-$THINK_MODEL}"

# The reply call is bounded twice, on its own, never inherited from the mind:
# RESPONDER_MAX_TOKENS caps the output (reasoning counts against it; the
# largest real reply on either persona was about 5K tokens, nearly all
# thinking, and a DeepSeek runaway pads whitespace up to whatever the cap
# is) and RESPONDER_MAX_TIME caps the wall clock (the inherited 600 s let one
# runaway hold a reply for ten minutes on 2026-09-21). bin/llm's own retries
# are off here: a second three-minute attempt is not a chat reply.
RESPONDER_MAX_TOKENS="${RESPONDER_MAX_TOKENS:-8192}"
RESPONDER_MAX_TIME="${RESPONDER_MAX_TIME:-180}"

# Wall-clock milliseconds, for compose_ms. Same perl path bin/traj uses for
# its timestamps; the fallback is whole seconds, still a valid number.
_now_ms() {
    perl -MTime::HiRes=time -e 'printf "%d\n", time*1000' 2>/dev/null \
        || printf '%s000\n' "$(date +%s)"
}
t_start_ms=$(_now_ms)

# What the reply call(s) did, merged into every decision observation by
# _finish_metrics: llm_ms (all calls), llm_calls, out_tok / think_tok /
# served_by (from bin/llm's usage record; served_by is OpenRouter's upstream
# host, one model id there is two dozen hosts at different speeds),
# truncated, timed_out. Failures add `failure`: timeout, truncated, parse,
# markup, empty, send.
_llm_meta='{}'
_llm_timed_out=0
_llm_truncated=0
_llm_calls=0
# _reply_llm runs inside a command substitution (its stdout is the reply),
# so its record travels through a file (_rl_meta_file, made right before the
# call) and _rl_sync pulls it into this shell.
_rl_meta_file=""
_reply_llm() {   # _reply_llm <llm args...>; stdout = the reply, rc = llm's rc
    local usage err rc t0 ms rec prev
    usage=$(mktemp) || return 1
    err=$(mktemp) || { rm -f "$usage"; return 1; }
    t0=$(_now_ms)
    rc=0
    LLM_USAGE_FILE="$usage" LLM_MAX_TIME="$RESPONDER_MAX_TIME" LLM_RETRIES=0 \
        llm -t "$RESPONDER_MAX_TOKENS" "$@" 2>"$err" || rc=$?
    ms=$(( $(_now_ms) - t0 ))
    cat "$err" >&2
    local truncated=0 timed_out=0
    grep -q 'output truncated at max_tokens' "$err" 2>/dev/null && truncated=1
    grep -qE 'timed out|curl: \(28\)' "$err" 2>/dev/null && timed_out=1
    rec=""
    [[ -s "$usage" ]] && rec=$(jq -c 'select(type == "object")' "$usage" 2>/dev/null | head -1)
    [[ -n "$rec" ]] || rec='{}'
    prev=$(cat "$_rl_meta_file" 2>/dev/null); [[ -n "$prev" ]] || prev='{}'
    jq -nc --argjson prev "$prev" --argjson rec "$rec" --argjson ms "$ms" \
        --argjson tr "$truncated" --argjson to "$timed_out" '
        $prev
        + {llm_ms: (($prev.llm_ms // 0) + $ms), llm_calls: (($prev.llm_calls // 0) + 1)}
        + ($rec | {out_tok, think_tok, served_by} | with_entries(select(.value != null)))
        + (if $tr == 1 or ($rec.truncated == true) then {truncated: true} else {} end)
        + (if $to == 1 then {timed_out: true} else {} end)' > "$_rl_meta_file" 2>/dev/null \
        || printf '%s' "$prev" > "$_rl_meta_file"
    rm -f "$usage" "$err"
    return "$rc"
}
_rl_sync() {   # after each _reply_llm: its record into this shell's variables
    _llm_meta=$(cat "$_rl_meta_file" 2>/dev/null); [[ -n "$_llm_meta" ]] || _llm_meta='{}'
    _llm_timed_out=$(printf '%s' "$_llm_meta" | jq -r 'if .timed_out == true then 1 else 0 end' 2>/dev/null) || _llm_timed_out=0
    _llm_truncated=$(printf '%s' "$_llm_meta" | jq -r 'if .truncated == true then 1 else 0 end' 2>/dev/null) || _llm_truncated=0
    _llm_calls=$(printf '%s' "$_llm_meta" | jq -r '.llm_calls // 0' 2>/dev/null) || _llm_calls=0
}

# Card redaction for everything this step writes: the reply sent back, the
# observations, the deferral handoff, and person notes. The triggering
# message is the record and keeps its raw content in the log, and the model
# still sees the raw text in its prompt (the work may need the digits); what
# stays out is OUR restatements, because recap lifts digit text upward into
# sealed summary blocks. Redaction is by shape first (three or four groups
# of four with single separators, or a contiguous 13-19 digit run) and by
# keyword second (card/pan/credit/debit/amex/visa/mastercard near a long
# digit run, which also catches Amex's 4-6-5 grouping), plus keyword-anchored
# cvv and expiry forms. A bare MM/YY is deliberately not redacted: that is
# also a date and dates are facts the work needs, so an expiry only goes
# when a keyword says it is one. Verification codes stay: an OTP relayed in
# chat is the work's input. POSIX ERE only: stock macOS sed has no word boundary escape (the CI Mac job caught these rules silently not matching there), so every boundary is an explicit (^|[^0-9A-Za-z]) restored by backreference; the I flag is honored on both the GNU and FreeBSD lineages.
_redact_card() {
    sed -E \
        -e 's/[0-9]{4}([ -][0-9]{4}){2,3}/[card redacted]/g' \
        -e 's/(^|[^0-9A-Za-z])[0-9]{13,19}/\1[card redacted]/g' \
        -e 's/(^|[^0-9A-Za-z])(card|pan|credit|debit|amex|visa|mastercard)[^A-Za-z0-9]{0,8}(the |is |was )?[0-9][0-9 -]{11,27}[0-9]/\1\2 [card redacted]/Ig' \
        -e 's/(^|[^0-9A-Za-z])(cvv|cvc|cvv2|csc|security code|sec code)[ :.,=-]*(the |is |was )?[0-9]{3,4}/\1\2 [redacted]/Ig' \
        -e 's/(^|[^0-9A-Za-z])(exp|expiry|expiration|expires|good (through|thru))[ :.,=-]*(the |is |was )?[0-9]{1,2}\/[0-9]{2,4}/\1\2 [redacted]/Ig'
}

# Read the triggering step from stdin.
step_json=$(cat)
[[ -z "$step_json" ]] && exit 0
trigger_type=$(printf '%s' "$step_json" | jq -r '.type // empty' 2>/dev/null) || true
trigger_content=$(printf '%s' "$step_json" | jq -r '.content // empty' 2>/dev/null) || true
trigger_step_id=$(printf '%s' "$step_json" | jq -r '.step_id // empty' 2>/dev/null) || true

# One redacted excerpt for every observation that quotes the message: the
# failure exits below (timeout, token cap, broken JSON, raw JSON) and the
# quiet paths all interpolate this, never the raw content. Redacted before
# the 200-byte cut so digits straddling the cut are still caught.
trigger_excerpt=$(printf '%s' "$trigger_content" | _redact_card)
trigger_excerpt=$(printf '%.200s' "$trigger_excerpt")

[[ "$trigger_type" == "message" ]] || exit 0

msg_to=$(printf '%s' "$step_json" | jq -r '.to // empty' 2>/dev/null) || true
msg_from=$(printf '%s' "$step_json" | jq -r '.from // "human"' 2>/dev/null) || true

# Only reply to messages addressed to this identity.
[[ "$msg_to" == "$IDENTITY_NAME" ]] || exit 0

# Stale-trigger guard. A message step is dispatched within a second of being
# appended, so a trigger stamped long ago is not a new message: it is history
# re-fed by the dispatcher (2026-09-12: the trajectory file was rewritten,
# `tail -F` replayed the whole log, and this step answered month-old Slack
# threads for 22 hours). Second line of defense behind the dispatcher's own
# rewind guard. Deliberately no observation step: one would wake the monolith
# per stale message, which is the flood this prevents. 0 disables; set it
# when a deliberate catch-up after downtime should answer older messages.
_max_age="${RESPONDER_MAX_TRIGGER_AGE:-900}"
if [[ "$_max_age" =~ ^[0-9]+$ && "$_max_age" -gt 0 ]]; then
    _trig_epoch=$(printf '%s' "$step_json" | jq -r \
        '(.ts // empty) | sub("\\.[0-9]+"; "") | sub("\\+0000$"; "Z") | fromdateiso8601? // empty' 2>/dev/null) || _trig_epoch=""
    if [[ "$_trig_epoch" =~ ^[0-9]+$ ]]; then
        _trig_age=$(( $(date +%s) - _trig_epoch ))
        if (( _trig_age > _max_age )); then
            printf '  stale trigger: message %s from %s is %ss old (RESPONDER_MAX_TRIGGER_AGE=%s) — replayed history, not a new message; not replying\n' \
                "$trigger_step_id" "$msg_from" "$_trig_age" "$_max_age" >&2
            exit 0
        fi
    fi
fi

# Append an observation step crediting this thinker, tagged with the
# trigger step when known. $1 = content, $2 (optional) = decision field,
# $3 (optional) = a JSON object of extra fields (the context metrics below).
_obs() {
    local extra="${3:-}"
    [[ -n "$extra" ]] || extra='{}'
    jq -nc --arg content "$1" --arg source "$THINKER_NAME" \
        --arg trigger "$trigger_step_id" --arg decision "${2:-}" \
        --argjson extra "$extra" \
        '{type:"observation", content:$content, source:$source}
         + (if $decision == "" then {} else {decision: $decision} end)
         + (if $trigger == "" then {} else {trigger_step: $trigger} end)
         + $extra' \
        | traj append >/dev/null || true
}

# Self-message guard: replying would create a self-chat loop.
if [[ "$msg_from" == "$IDENTITY_NAME" ]]; then
    printf '  self-message — dropping with observation\n' >&2
    _obs "self-message dropped: you chat-sent a message to yourself and it will not be replied to (replying would loop). To message someone else use: chat reply <their-name> <message>. To keep a note for later, write it as a thought step instead. Your message was: $trigger_excerpt"
    exit 0
fi

[[ -z "$trigger_content" ]] && exit 0

# Idempotency, three layers keyed on the trigger step:
#   1. a stamped reply from us — definitively handled;
#   2. our own decision observation ("replied" or "no-reply") — makes a
#      deliberate NO_REPLY stick across redelivery instead of re-composing
#      (and possibly answering) a message the mind chose to leave alone;
#   3. a FRESH reply_claim (< CLAIM_TTL seconds) — another responder is
#      composing right now (orphan-dispatcher double-dispatch delivers the
#      same step twice); without this the race window is the whole compose.
# A STALE bare claim deliberately does NOT count: that is the crashed/failed
# send, and treating it as handled is how messages used to drop forever.
# chat reply's answered guard backstops whatever slips through all three.
CLAIM_TTL="${RESPONDER_CLAIM_TTL:-180}"
if [[ -n "$trigger_step_id" ]]; then
    # traj stamps ts in UTC ("%Y-%m-%dT%H:%M:%S.mmmZ", see _iso_ts), so the
    # cutoff MUST be UTC too — a local-clock cutoff skews the freshness
    # window by the whole UTC offset on any non-UTC host. Bare-seconds UTC
    # compares correctly against the stamped form lexicographically. Empty
    # cutoff (date variant unsupported) fails open: claims count as stale,
    # a retry is safer than a dropped message.
    claim_cutoff=$(date -u -v-"${CLAIM_TTL}"S +%Y-%m-%dT%H:%M:%S 2>/dev/null \
        || date -u -d "${CLAIM_TTL} seconds ago" +%Y-%m-%dT%H:%M:%S 2>/dev/null) || claim_cutoff=""
    already=$(_responder_already_handled "$trigger_step_id" "$msg_from" "$claim_cutoff") || already=""
    if [[ -n "$already" ]]; then
        printf '  already handled step %s (reply/decision/live claim) — skipping\n' "$trigger_step_id" >&2
        exit 0
    fi
fi

# ---------------------------------------------------------------------------
# Claim: an audit-trail step recording that this responder began handling
# the message. NOT consulted for idempotency (see header) — the monolith no
# longer subscribes to message steps, and a bare claim must never suppress
# a retry after a failed send.
# ---------------------------------------------------------------------------
printf '  claiming reply to %s...\n' "$msg_from" >&2
jq -nc \
    --arg source "$THINKER_NAME" \
    --arg trigger "$trigger_step_id" \
    --arg from "$msg_from" \
    '{type:"reply_claim", content:("handling reply to " + $from), source:$source}
     + (if $trigger == "" then {} else {trigger_step: $trigger} end)' \
    | traj append >/dev/null || true

# ---------------------------------------------------------------------------
# Compose and send the reply
# ---------------------------------------------------------------------------
system_prompt=$(_build_system_prompt)
recent_context=""
if traj exists 2>/dev/null; then
    recent_context=$(_recent_stream "$THINK_CONTEXT_TAIL") || recent_context=""
fi

# The conversation: this person's messages with us over the last
# RESPONDER_HISTORY_SINCE (7d), grouped by person key across every routing name
# they use (Slack thread names, DM name, phone chat), read from the derived
# message index via `chat history --with` (design/conversation_memory.md,
# parts 1+2). Each of their messages is stamped with its age so the model can
# tell "this morning" from "six days ago" (Experiment C found both new prompts
# misread time without it). Falls back to the recent-stream window when the
# index cannot be read. The step id of each message is kept alongside so the
# observation below can record exactly which steps were in the prompt.
HISTORY_SINCE="${RESPONDER_HISTORY_SINCE:-7d}"
HISTORY_MAX="${RESPONDER_HISTORY_MAX:-20}"
_age_jq='def age: ((now - ((.ts // "")[0:19] + "Z" | try fromdateiso8601 catch now)) | floor) as $s
    | if $s < 90 then "just now"
      elif $s < 5400 then "\(($s / 60) | floor) min ago"
      elif $s < 172800 then "\(($s / 3600) | floor) h ago"
      else "\(($s / 86400) | floor) days ago" end;'
# Thread context: in a Slack channel thread other people talk too, and their
# messages are the conversation the sender is replying into. Add the thread's
# last RESPONDER_THREAD_SINCE (1d) of messages from anyone; the union is
# de-duplicated by step id below. DMs, the phone chat and Telegram have no
# thread, so this adds nothing there.
THREAD_SINCE="${RESPONDER_THREAD_SINCE:-1d}"
THREAD_MAX="${RESPONDER_THREAD_MAX:-20}"
thread_key=$(chat thread-key "$msg_from" 2>/dev/null) || thread_key=""
history_json=$(chat history --with "$msg_from" --since "$HISTORY_SINCE" -n "$HISTORY_MAX" --json 2>/dev/null) || history_json=""
thread_json="[]"
if [[ -n "$thread_key" ]]; then
    thread_json=$(chat history --thread "$msg_from" --since "$THREAD_SINCE" -n "$THREAD_MAX" --json 2>/dev/null) || thread_json="[]"
    [[ -n "$thread_json" ]] || thread_json="[]"
fi
history_source="index"
if [[ -z "$history_json" || "$history_json" == "[]" ]]; then
    # Nothing indexed for this person (or the index is unreadable): fall back
    # to the messages in the recent-stream window, as before parts 1+2.
    history_source="window"
    history_json=$(printf '%s\n' "$recent_context" | jq -cRn \
        --arg me "$IDENTITY_NAME" --arg them "$msg_from" '
        [inputs | fromjson? // empty
         | select(.type == "message"
                  and ((.from == $them and .to == $me) or (.from == $me and .to == $them)))]' 2>/dev/null) \
        || history_json="[]"
fi
# Roles by direction: anything we sent is an assistant turn, anything sent to
# us (by the sender or by someone else in the thread; the bridge header in the
# text names the speaker) is a user turn stamped with its age. Union of person
# history and thread context, de-duplicated by step id, in time order. The
# trigger always ends the list exactly once (it is usually already indexed,
# but may not be if the index update lost a race).
convo_sel=$(jq -nc --argjson person "$history_json" --argjson thread "$thread_json" \
    --arg me "$IDENTITY_NAME" --arg c "$trigger_content" --arg t "$trigger_step_id" "$_age_jq"'
    ($person | map(.step_id // "")) as $pids
    | ($person + $thread)
    | unique_by(.step_id) | sort_by(.ts // "")
    | map((.step_id // "") as $sid
          | if .to == $me then {role:"user", content:("[\(age)] " + (.content|tostring)), step_id:$sid, thread_only: (($pids | index($sid)) == null)}
            elif .from == $me then {role:"assistant", content:(.content|tostring), step_id:$sid, thread_only: (($pids | index($sid)) == null)}
            else empty end)
    | map(select(.step_id != $t)) + [{role:"user", content:$c, step_id:$t, thread_only:false}]
    | (if (.[0].role // "user") == "assistant" then .[1:] else . end)' 2>/dev/null) \
    || convo_sel=$(jq -nc --arg c "$trigger_content" --arg t "$trigger_step_id" '[{role:"user", content:$c, step_id:$t, thread_only:false}]')
convo_json=$(printf '%s' "$convo_sel" | jq -c 'map({role, content})')
now_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)

inner_sel=$(printf '%s\n' "$recent_context" | jq -cR \
    'fromjson? // empty | select(.type != "message")' 2>/dev/null | tail -n 8) || inner_sel=""
inner_context=$(printf '%s\n' "$inner_sel" | jq -r \
    '"[\(.type)] \(.content|tostring)"' 2>/dev/null) || inner_context=""

# Context metrics, recorded on the decision observation so "how much of the
# conversation did the responder actually have?" is a fact in the log rather
# than a reconstruction (design/conversation_memory.md, part 6):
#   context_msgs   earlier messages with this person in the prompt (the
#                  trigger itself excluded)
#   context_steps  step ids of everything in the prompt (conversation + the
#                  inner-life excerpt); enough to rebuild the exact prompt
#   thread_msgs    how many of those came only from the thread (other
#                  people's messages, and ours to them)
#   history_source "index" (chat history --with) or "window" (the
#                  recent-stream fallback)
#   model          the reply model
#   compose_ms     wake to decision (added below)
#   gap_s          seconds since the previous message exchanged with this
#                  person, read from the raw tail (added below; absent when
#                  none is in the tail)
metrics_json=$(jq -nc --arg t "$trigger_step_id" --arg model "$REPLY_MODEL" \
    --argjson convo "$convo_sel" \
    --argjson inner "$(printf '%s\n' "$inner_sel" | jq -cs 'map(.step_id // empty)' 2>/dev/null || echo '[]')" \
    --arg hs "$history_source" '
    {context_msgs: ([$convo[] | select(.step_id != $t)] | length),
     thread_msgs: ([$convo[] | select(.step_id != $t and .thread_only == true)] | length),
     context_steps: (([$convo[].step_id] + $inner) | map(select(. != ""))),
     history_source: $hs,
     model: $model}')

# Seconds between the trigger and the previous message exchanged with this
# person. Read from the raw tail, not the filtered window: the window is the
# thing that forgets, and this number has to be right exactly when it does.
_gap_s() {
    local trig_ts
    trig_ts=$(printf '%s' "$step_json" | jq -r '.ts // empty' 2>/dev/null) || trig_ts=""
    [[ -n "$trig_ts" ]] || return 0
    _root_traj_raw_tail | jq -Rrn --arg me "$IDENTITY_NAME" --arg them "$msg_from" \
        --arg t "$trigger_step_id" --arg tts "$trig_ts" '
        def secs: .[0:19] + "Z" | try fromdateiso8601 catch empty;
        [inputs | fromjson? // empty
         | select(.type == "message" and (.step_id // "") != $t
                  and (.reply_to // "") != $t
                  and (.ts // "") != "" and .ts < $tts
                  and ((.from == $them and .to == $me) or (.from == $me and .to == $them)))
         | .ts] | last // empty
        | (($tts | secs) - (. | secs))' 2>/dev/null
}

# Finish the metrics right before the decision observation is written, so
# compose_ms covers everything up to (and including) the send.
_finish_metrics() {
    local ms gap
    ms=$(( $(_now_ms) - t_start_ms ))
    gap=$(_gap_s) || gap=""
    printf '%s' "$metrics_json" | jq -c --argjson ms "$ms" --arg g "$gap" --argjson llm "$_llm_meta" --arg p "${_parse:-}" \
        '. + $llm + {compose_ms: $ms} + (if $g == "" then {} else {gap_s: ($g | tonumber)} end)
           + (if $p == "" then {} else {parse: $p} end)' \
        2>/dev/null || printf '%s' "$metrics_json"
}
_fail_metrics() {   # _fail_metrics <kind>: the metrics plus what went wrong
    _finish_metrics | jq -c --arg k "$1" '. + {failure: $k}' 2>/dev/null || _finish_metrics
}

# ---------------------------------------------------------------------------
# Person notes (design/conversation_memory.md, part 4): a `type: person` memory
# per person key, written by _update_person_notes after each reply and read
# here into the system prompt. Aliases in its frontmatter are what
# `chat history --with` merges. mem's own frontmatter is kept (id, summary,
# type, created, updated) plus person_key and aliases; written directly, not
# via `mem update`, which would drop the extra fields.
# ---------------------------------------------------------------------------
person_key=$(chat person-key "$msg_from" 2>/dev/null) || person_key="$msg_from"

# _person_notes_file <key> — path of the person memory for <key>, or nothing.
_person_notes_file() {
    local key="$1" f
    [[ -n "${MEM_DIR:-}" && -d "$MEM_DIR" ]] || return 0
    for f in "$MEM_DIR"/*.md; do
        [[ -f "$f" ]] || continue
        awk -v key="$key" '
            NR==1 && /^---$/ {fm=1; next}
            fm && /^---$/ {exit}
            fm && /^type:[[:space:]]*person[[:space:]]*$/ {t=1}
            fm && /^person_key:/ {sub(/^person_key:[[:space:]]*/, ""); k=$0}
            fm && /^aliases:[[:space:]]*\[/ {a=$0; sub(/^aliases:[[:space:]]*\[/, "", a); sub(/\].*$/, "", a); gsub(/[[:space:]"]/, "", a); n=split(a, parts, ","); for (i=1;i<=n;i++) if (parts[i]==key) k2=1}
            fm && /^[[:space:]]*-[[:space:]]*/ {v=$0; sub(/^[[:space:]]*-[[:space:]]*/, "", v); gsub(/"/, "", v); if (v==key) k2=1}
            END {exit !(t && (k==key || k2))}' "$f" 2>/dev/null && { printf '%s\n' "$f"; return 0; }
    done
    return 0
}
_notes_body() {  # body after the frontmatter
    awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {fm=0; body=1; next} body {print}' "$1" | sed '/./,$!d'
}
person_notes_block=""
if [[ "${RESPONDER_PERSON_NOTES:-1}" == "1" ]]; then
    _pnf=$(_person_notes_file "$person_key") || _pnf=""
    if [[ -n "$_pnf" ]]; then
        _pnb=$(_notes_body "$_pnf" | head -n 20)
        [[ -n "$_pnb" ]] && person_notes_block="What you know about $msg_from (your own notes; keep them in mind, do not
recite them, and do not treat one past incident as a rule):
$_pnb

"
    fi
fi

# ---------------------------------------------------------------------------
# Reply voice and shape
# ---------------------------------------------------------------------------
# The voice is concrete bans, not adjectives. The 2026-09-16 replay of 57
# real prompts (headlong-experiments/responder-defer) showed "first person,
# natural, conversational, concise" left 94% of replies with em dashes, a
# third over 400 characters and a fifth in three or more paragraphs; this
# block cut those to 3%, 3% and 0% and a blind judge preferred its
# readability 20 to 1. The deferral protocol is stated INSIDE the block on
# purpose: the same block without it halved deferrals and produced bare
# "Let me look into that" replies with no work behind them.
#
# Shape: with RESPONDER_STRUCTURED=1, or auto (default) on a model whose
# provider enforces a JSON Schema, the model returns one object
# {action, message, request} through `llm --json-schema` (reply.schema.json
# beside this step), which makes the reply/defer/no_reply decision a
# required field instead of a first line the model can forget. On the same
# replay the structured form kept every deferral and was judged clearer
# 12 to 6. Any other model, RESPONDER_STRUCTURED=0, or a failed schema call
# uses the text protocol (DEFER: first line / NO_REPLY) unchanged.
RESPONDER_STRUCTURED="${RESPONDER_STRUCTURED:-auto}"
_schema_file="$SCRIPT_DIR/reply.schema.json"
_supports_schema() {
    case "$1" in
        deepseek/*|x-ai/*|z-ai/glm-5*|moonshotai/*|qwen/*|meta-llama/*|mistralai/*|google/gemini*|openai/*|gpt-4o*|gpt-5*|o1*|o3*|o4*) return 0 ;;
        *) return 1 ;;
    esac
}
structured=0
case "$RESPONDER_STRUCTURED" in
    1) structured=1 ;;
    0) structured=0 ;;
    *) _supports_schema "$REPLY_MODEL" && structured=1 ;;
esac
[[ -f "$_schema_file" ]] || structured=0

_compose_reply_system() {   # $1 = 1 structured, 0 text; sets reply_system
    local defer_rule defer_para noreply_rule output_para
    if [[ "$1" -eq 1 ]]; then
        defer_rule='answer with action "defer", the work in "request" (one line) and one short
  holding sentence in "message". A holding sentence with action "reply" is a
  promise nobody will keep.'
        defer_para='Answer completely from what you already know. If a real answer needs tools,
files, or looking something up, do not guess and do not promise to check
yourself: hand the work to the mind with action "defer" and send a short
holding message such as "Let me look into that and get back to you." The
mind follows up with the result.'
        noreply_rule='use action "no_reply" with an empty message.'
        output_para='Output ONLY one JSON object and nothing else (no code fence, no preamble):
{"action": "reply" | "defer" | "no_reply",
 "message": "the reply text to send; empty when no_reply",
 "request": "one line describing the work for the mind; only when defer, else empty"}
The message follows the rules above: no dashes, no markdown, no praise
opener, no closing question. It is delivered automatically: never write
'"'"'chat reply'"'"' or the recipient'"'"'s address inside it, and never put commands in it.
Check before you answer: does this need work you cannot do inside this reply?
Then action is "defer", request is the work, message is the holding sentence.'
    else
        defer_rule='write `DEFER: <the work, one line>` as the first line and one short holding
  sentence as the second. A holding sentence without the DEFER line is a
  promise nobody will keep.'
        defer_para='Answer completely from what you already know. If a real answer needs tools,
files, or looking something up, do not guess and do not promise to check
yourself: put `DEFER: <the work, one line>` on the first line, then the short
message to send (e.g. "Let me look into that and get back to you."). The work
is handed to the mind, which follows up with the result.'
        noreply_rule='output exactly NO_REPLY on its own line and nothing else.'
        output_para='Output ONLY the reply message text, no preamble, no quotes, no commands.
Delivery is automatic: never write '"'"'chat reply'"'"' or the recipient'"'"'s address.
Check before you answer: does this need work you cannot do inside this reply?
Then the first line is DEFER: and the second is the holding sentence.'
    fi
    reply_system="$system_prompt

The current time is $now_utc. You are in a live chat conversation with
$msg_from. The messages are the real back-and-forth so far, spanning up to
$HISTORY_SINCE; each of their messages is prefixed with how long ago it was sent,
so mind the gaps (an answer from days ago is not \"this morning\"). In a group
thread some earlier messages are from other people (the header in each message
names the speaker); they are context, and you are answering $msg_from. Reply to
their newest message the way the people in this chat write to each other:
plain sentences, first person, one to three sentences unless they asked for
detail. These rules hold even when you feel you are being helpful:
- No dashes of any kind. Use a period or a comma.
- Do not open by praising or agreeing (\"Good question\", \"Fair\", \"Got it\",
  \"Makes sense\"). Start with the answer.
- No bold, headers, bullets, or code formatting in chat. If the answer needs
  a list or more than a short paragraph, give the short version and offer to
  put the rest in a thread or a file.
- Do not end with a question unless you need the answer to continue.
- Do not describe your own machinery (wakes, trajectory, responder, bridge,
  thinkers, prompts) unless they asked about it.
- If they ask you to do something, or the answer needs a file, a tool, or a
  lookup, do not answer from guesswork and do not just say you will do it:
  $defer_rule
- Say what you know, then stop. No filler, no restating their message, no
  sign-off, no \"happy to help\".
- Everyday words. No \"delve\", \"robust\", \"leverage\", \"landscape\", \"nuance\".
  Repeat a word rather than swap in a synonym.
Never repeat or rephrase an earlier reply of yours.
$defer_para

Not every message needs a reply. If their newest message is already answered
(a reply of yours addressing it is visible above), is a bare acknowledgment
like \"thanks\" or \"ok\", is a Slack reaction (a \`:emoji:\` body, optionally with \`(on <ts>)\`), or anything you could say would only repeat you,
$noreply_rule Staying quiet is
better than a duplicate or a contentless reply.

${person_notes_block}Your recent inner life (context only, not part of the conversation):
$inner_context

$output_para"
}
_compose_reply_system "$structured"

# ---------------------------------------------------------------------------
# Person notes writer (part 4). After a reply is sent, rewrite this person's
# notes from the previous notes plus the last 30 days of conversation, on a
# cheap model, in the background so the human never waits for it. Facts and
# stated preferences only: Experiment C showed a summary that led with one old
# refusal turned into a standing stance in 2 of 22 replies.
# ---------------------------------------------------------------------------
NOTES_MODEL="${RESPONDER_NOTES_MODEL:-${RECAP_MAP_MODEL:-$REPLY_MODEL}}"
_person_notes_system() {
    cat <<NOTES
You maintain $IDENTITY_NAME's private notes about one person they talk with,
$msg_from. Rewrite the notes from the previous notes plus the recent
conversation. Include only: who they are (name, role, how they reach
$IDENTITY_NAME), how they prefer to be talked to, ongoing threads and open
commitments with dates, and facts they stated. Rules: facts and stated
preferences only. Never turn one incident into a rule, a stance, or a policy
about the person, and do not record refusals or things $IDENTITY_NAME declined,
not even in neutral words: leave any declined request out entirely.
No secrets, keys, or credentials. Keep what is still true from the previous
notes and drop what the conversation shows is stale. At most 12 short lines of
plain text, no headers, no bullet syntax. Output only the notes.
NOTES
}
# Person notes are model output summarizing a conversation, and a conversation
# can contain a pasted credential. Mask the configured credential env values by
# value, then the shapes that arrive as text and so have no env var to match.
_redact_keys() {
    local s n v
    s=$(cat)
    for n in GITHUB_TOKEN GH_TOKEN HOMEBREW_GITHUB_API_TOKEN GITHUB_PAT \
             ANTHROPIC_API_KEY LLM_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY \
             GEMINI_API_KEY GOOGLE_API_KEY OPENCODE_API_KEY SLACK_BOT_TOKEN \
             SLACK_APP_TOKEN SLACK_USER_TOKEN SLACK_TOKEN TELEGRAM_BOT_TOKEN \
             HF_TOKEN HUGGING_FACE_HUB_TOKEN AWS_SECRET_ACCESS_KEY \
             AWS_SESSION_TOKEN AWS_ACCESS_KEY_ID STRIPE_SECRET_KEY \
             SENDGRID_API_KEY TWILIO_AUTH_TOKEN DATABASE_URL REDIS_URL; do
        v="${!n:-}"
        [[ -n "$v" && ${#v} -ge 8 ]] && s="${s//"$v"/[redacted]}"
    done
    printf '%s' "$s" | sed -E \
        -e 's/sk-ant-[A-Za-z0-9._-]+/[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(sk-[A-Za-z0-9_.=-]{12,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(gh[pousr]_[A-Za-z0-9]{12,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(github_pat_[A-Za-z0-9_]{12,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(xox[a-z]-[A-Za-z0-9_.-]{8,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(hf_[A-Za-z0-9]{12,})/\1[redacted]/g' \
        -e 's/AIza[A-Za-z0-9_-]{25,}/[redacted]/g' \
        -e 's/(AKIA|ASIA)[A-Z0-9]{16}/[redacted]/g' \
        -e 's/eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/[redacted]/g' \
        -e 's#://[^/@[:space:]]+:[^/@[:space:]]+@#://[redacted]@#g' \
        -e '/-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/,/-----END [A-Z0-9 ]*PRIVATE KEY-----/c\
[redacted]' \
        -e 's#"auth"[[:space:]]*:[[:space:]]*"[A-Za-z0-9+/=]{16,}"#"auth": "[redacted]"#g' \
        -e 's/(^|[^A-Za-z0-9])((sk|rk)_live_[A-Za-z0-9]{8,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(whsec_[A-Za-z0-9]{8,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(npm_[A-Za-z0-9]{20,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(glpat-[A-Za-z0-9_-]{10,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(dckr_pat-[A-Za-z0-9_.-]{10,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(SG\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(SK[0-9a-f]{32})/\1[redacted]/g' \
        -e 's/(^|[^A-Za-z0-9])(key-[A-Za-z0-9]{20,})/\1[redacted]/g' \
        -e 's/((aws|AWS)_secret_access_key)[[:space:]]*[=:][[:space:]]*[^[:space:]]+/\1=[redacted]/g' | _redact_card
}
_update_person_notes() {
    local key="$1" person="$2" hist prev_body prev_file system user new_body
    local lockdir="${MEM_DIR:-/tmp}/.person-notes.lock"
    mkdir -p "${MEM_DIR:-/tmp}" 2>/dev/null || return 0
    mkdir "$lockdir" 2>/dev/null || return 0   # another writer is on it
    # shellcheck disable=SC2064
    trap "rmdir '$lockdir' 2>/dev/null" EXIT
    hist=$(chat history --with "$person" --since "${RESPONDER_NOTES_SINCE:-30d}" -n "${RESPONDER_NOTES_MAX:-40}" --json 2>/dev/null) || hist="[]"
    [[ -n "$hist" && "$hist" != "[]" ]] || return 0
    prev_file=$(_person_notes_file "$key") || prev_file=""
    prev_body=""; [[ -n "$prev_file" ]] && prev_body=$(_notes_body "$prev_file")
    system=$(_person_notes_system)
    user=$(printf '%s' "$hist" | jq -r --arg me "$IDENTITY_NAME" '
        .[] | "\(.ts // "?" | .[0:16]) \(if .from == $me then $me else "them" end): \(.content | tostring | .[0:600])"')
    user="Previous notes:
${prev_body:-(none yet)}

Recent conversation (UTC, oldest first; \"them\" is $person):
$user

Now: $(date -u +%Y-%m-%dT%H:%MZ). Output the rewritten notes."
    new_body=$(llm -m "$NOTES_MODEL" -s "$system" -M "$(jq -nc --arg u "$user" '[{role:"user", content:$u}]')" 2>/dev/null | _redact_keys | head -n 20) || new_body=""
    new_body=$(printf '%s' "$new_body" | sed '/./,$!d')
    [[ -n "$new_body" ]] || return 0
    local now summary
    now=$(date +"%Y-%m-%d %H:%M:%S")
    summary="Notes on $person: $(printf '%s' "$new_body" | head -1 | cut -c1-60)"
    if [[ -n "$prev_file" ]]; then
        # Rewrite in place, keeping id/created/person_key/aliases as they are.
        local fm id created aliases_block
        fm=$(awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {exit} fm {print}' "$prev_file")
        id=$(printf '%s\n' "$fm" | sed -n 's/^id:[[:space:]]*//p' | head -1)
        created=$(printf '%s\n' "$fm" | sed -n 's/^created:[[:space:]]*//p' | head -1)
        aliases_block=$(printf '%s\n' "$fm" | awk '/^aliases:/{p=1; print; next} p && /^[[:space:]]*-[[:space:]]/{print; next} p{p=0}')
        [[ -z "$aliases_block" ]] && aliases_block="aliases: []"
        {
            printf -- '---\n'
            [[ -n "$id" ]] && printf 'id: %s\n' "$id"
            printf 'summary: %s\ntype: person\nperson_key: %s\n%s\ncreated: %s\nupdated: %s\n---\n\n%s\n' \
                "$summary" "$key" "$aliases_block" "${created:-$now}" "$now" "$new_body"
        } > "$prev_file.tmp" && mv -f "$prev_file.tmp" "$prev_file"
    else
        local hex slug
        hex=$(head -c4 /dev/urandom | od -An -tx1 | tr -d ' \n')
        slug=$(printf 'person-%s' "$key" | tr -c 'A-Za-z0-9\n' '-' | tr -s '-' | sed 's/^-//;s/-$//' | cut -c1-60)
        printf -- '---\nid: %s\nsummary: %s\ntype: person\nperson_key: %s\naliases: []\ncreated: %s\n---\n\n%s\n' \
            "$hex" "$summary" "$key" "$now" "$new_body" \
            > "$MEM_DIR/$(date +%Y-%m-%d-%H-%M-%S)_${hex}_${slug}.md"
    fi
}
_update_person_notes_async() {
    [[ "${RESPONDER_PERSON_NOTES:-1}" == "1" ]] || return 0
    if [[ "${RESPONDER_PERSON_NOTES_SYNC:-0}" == "1" ]]; then
        ( _update_person_notes "$person_key" "$msg_from" ) || true
    else
        local _nlog="${IDENTITY_DIR:-.}/run/logs/responder-notes.log"
        mkdir -p "$(dirname "$_nlog")" 2>/dev/null || true
        ( _update_person_notes "$person_key" "$msg_from" ) >>"$_nlog" 2>&1 </dev/null &
    fi
}

# Debug aid: RESPONDER_LOG_PROMPT=1 writes the exact prompt to a rotated file
# under run/logs/, never to the mind log (the system half is identical on
# every call, and the trajectory is already mostly repeated prompt text).
if [[ "${RESPONDER_LOG_PROMPT:-0}" == "1" && -n "${IDENTITY_DIR:-}" ]]; then
    _plog_dir="$IDENTITY_DIR/run/logs/responder-prompts"
    if mkdir -p "$_plog_dir" 2>/dev/null; then
        _plog="$_plog_dir/$(date -u +%Y%m%dT%H%M%SZ)_${trigger_step_id:-notrigger}.txt"
        printf '# system\n%s\n\n# messages\n%s\n' "$reply_system" "$convo_json" > "$_plog" 2>/dev/null || true
        ls -1t "$_plog_dir" 2>/dev/null | tail -n +"$(( ${RESPONDER_LOG_PROMPT_KEEP:-50} + 1 ))" \
            | while IFS= read -r _old; do rm -f "$_plog_dir/$_old"; done
    fi
fi

printf '  replying to %s...\n' "$msg_from" >&2
reply=""
_parse="text"
_rl_meta_file=$(mktemp)
printf '{}' > "$_rl_meta_file"
if [[ "$structured" -eq 1 ]]; then
    _parse="structured"
    if ! reply=$(_reply_llm -m "$REPLY_MODEL" -M "$convo_json" -s "$reply_system" --json-schema "$_schema_file"); then
        _rl_sync
        if [[ "$_llm_timed_out" -eq 1 || "$_llm_truncated" -eq 1 ]]; then
            # The budget is spent (the wall clock, or the whole token cap on
            # nothing visible); a second attempt would only double the wait.
            printf '  structured reply call spent its budget (timed out: %s, truncated: %s) — not retrying\n' "$_llm_timed_out" "$_llm_truncated" >&2
            reply=""
        else
            # The provider refused the schema (or the call failed fast): once
            # more as plain text so a model without structured output answers.
            printf '  structured reply call failed — retrying as plain text\n' >&2
            structured=0
            _parse="text"
            _compose_reply_system 0
            reply=$(_reply_llm -m "$REPLY_MODEL" -M "$convo_json" -s "$reply_system") || true
            _rl_sync
            _llm_meta=$(printf '%s' "$_llm_meta" | jq -c '. + {fallback: true}' 2>/dev/null || printf '%s' "$_llm_meta")
            printf '%s' "$_llm_meta" > "$_rl_meta_file"
        fi
    fi
else
    reply=$(_reply_llm -m "$REPLY_MODEL" -M "$convo_json" -s "$reply_system") || true
fi
_rl_sync
rm -f "$_rl_meta_file"

# Nothing came back and the call itself was the reason: say which.
if [[ -z "$(printf '%s' "$reply" | tr -d '[:space:]')" ]]; then
    if [[ "$_llm_timed_out" -eq 1 ]]; then
        printf '  reply call timed out — appending failure observation\n' >&2
        _obs "reply failed: the model took longer than ${RESPONDER_MAX_TIME}s to answer $msg_from, so nothing was sent. Reply to them yourself. Their message was: $trigger_excerpt" reply-failed "$(_fail_metrics timeout)"
        exit 0
    fi
    if [[ "$_llm_truncated" -eq 1 ]]; then
        printf '  reply hit the %s token cap with nothing usable — appending failure observation\n' "$RESPONDER_MAX_TOKENS" >&2
        _obs "reply failed: the model spent its whole ${RESPONDER_MAX_TOKENS} token budget answering $msg_from and produced nothing usable, so nothing was sent. Reply to them yourself. Their message was: $trigger_excerpt" reply-failed "$(_fail_metrics truncated)"
        exit 0
    fi
fi

# Structured reply: read the object and hand the rest of the step the text
# protocol it already knows (NO_REPLY line, DEFER: line + holding sentence,
# or the message). An object that does not parse is treated as text, so a
# model that ignored the format still gets the DEFER parser and the markup
# guard below instead of an empty reply.
# A cut-off object is repaired when the cut fell outside a string (DeepSeek's
# 2026-09-21 shape: the object complete up to `"message":""`, then whitespace
# to the cap): closing braces make it whole and every field is what the model
# wrote. A cut inside a string is repaired only for no_reply, since a reply or
# holding message cut mid-sentence must not reach the person. An object that
# cannot be repaired is never sent as text: ten `{"action":"no_reply",...`
# fragments went to Slack that way.
_salvage_object() {   # _salvage_object <text>; stdout: the object, or nothing
    local t c out
    t=$(printf '%s' "$1" | sed -E '1s/^[[:space:]]*```(json)?[[:space:]]*//' | sed -E 's/[[:space:]]+$//')
    for c in '}' '}}' '"}' '"}}'; do
        out=$(printf '%s%s' "$t" "$c" | jq -c 'select(type == "object" and (.action | type) == "string")' 2>/dev/null) || continue
        [[ -n "$out" ]] || continue
        case "$c" in
            '"'*) [[ "$(printf '%s' "$out" | jq -r '.action | ascii_downcase')" == "no_reply" ]] || return 1 ;;
        esac
        printf '%s' "$out"
        return 0
    done
    return 1
}

if [[ "$structured" -eq 1 ]]; then
    _obj=$(printf '%s' "$reply" | sed -E '1s/^[[:space:]]*```(json)?[[:space:]]*//' | sed -E '$s/[[:space:]]*```[[:space:]]*$//' \
        | jq -c 'select(type == "object" and (.action | type) == "string")' 2>/dev/null) || _obj=""
    if [[ -z "$_obj" ]] && _obj=$(_salvage_object "$reply") && [[ -n "$_obj" ]]; then
        printf '  structured reply was cut off — repaired the object\n' >&2
        _parse="salvaged"
    fi
    if [[ -n "$_obj" ]]; then
        _action=$(printf '%s' "$_obj" | jq -r '.action | ascii_downcase')
        _message=$(printf '%s' "$_obj" | jq -r '.message // ""')
        _request=$(printf '%s' "$_obj" | jq -r '.request // "" | gsub("\n"; " ")')
        case "$_action" in
            no_reply) reply="NO_REPLY" ;;
            defer)    reply=$(printf 'DEFER: %s\n%s' "$_request" "$_message") ;;
            *)        reply="$_message" ;;
        esac
    elif printf '%s' "$reply" | grep -qE '^[[:space:]]*\{'; then
        printf '  structured reply did not parse and could not be repaired — not sending\n' >&2
        _obs "reply failed: the model's reply to $msg_from was a broken JSON object, so nothing was sent. Reply to them yourself. Their message was: $trigger_excerpt" reply-failed "$(_fail_metrics parse)"
        exit 0
    else
        printf '  structured reply did not parse as an object — treating it as text\n' >&2
        _parse="text"
    fi
fi

# Drop leading blank lines first: the NO_REPLY and DEFER protocols key off
# the first line, and a model that opens with a newline (Nemotron, 2026-09-10)
# otherwise gets its "DEFER: ..." line sent to the person as the reply, with
# no action step behind it.
reply=$(printf '%s' "$reply" | sed -E '/[^[:space:]]/,$!d')

# Strip a leaked delivery command if a model echoes one.
reply=$(printf '%s' "$reply" | sed -E '1s/^[[:space:]]*chat reply [A-Za-z0-9._-]+[[:space:]]*//')

# The model may judge that no reply is needed.
first_line=$(printf '%s' "$reply" | head -n 1 | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//')
if [[ "$first_line" == "NO_REPLY" ]]; then
    printf '  model declined to reply (NO_REPLY)\n' >&2
    _obs "Chose not to reply to $msg_from — their message needed no reply (already answered, or a bare acknowledgment). Their message was: $trigger_excerpt" no-reply "$(_finish_metrics)"
    exit 0
fi

# Deferral (design/conversation_memory.md, part 5): "DEFER: <work>" on the
# first line means the reply below it is a holding message and the real work
# goes to the mind as an `action` step. The monolith subscribes to actions,
# shows a PENDING REQUEST routing hint until an observation resolves it, and
# delivers the result with `chat reply --follow-up`. Without this the
# responder's "let me check" bound nobody (Experiment C: 6 to 9 of 22 replies
# promised work that never happened).
#
# The model does not always put the DEFER line first, or only once. Nemotron
# has emitted it after the holding text, and on 2026-09-14 twice: the holding
# sentence glued onto the first copy ("...headlong mainLet me open that PR
# for you.") and a clean copy on the next line, so line 1 became the request
# and line 2, still starting "DEFER:", was sent to Nick. So: the request is
# the first DEFER line wherever it is (a shorter DEFER line that is a prefix
# of it wins, which un-glues the duplicate case), every DEFER line is dropped
# from the text sent, and what is left is the holding message.
#
# 2026-09-15 23:58Z shape: the holding sentence glued in FRONT of the DEFER
# on one line ("...your wake prompt.DEFER: Investigate ..."), so the line
# started with prose, no DEFER line was found, and the whole thing went to
# Slack. A DEFER: glued to a non-space character is split onto its own line
# first. A DEFER: after a space is left alone on purpose: that is the model
# talking about the protocol ("the raw DEFER: handoff text"), not using it.
reply=$(printf '%s\n' "$reply" | awk '{
    i = index($0, "DEFER:")
    if (i > 1 && substr($0, i - 1, 1) !~ /[[:space:]]/) { print substr($0, 1, i - 1); print substr($0, i) } else print
}')

# The responder has no tools. A standalone <skills show ...> is an attempt
# to use one, so hand the original request to the mind. Match the whole
# reply: quoted commands, examples and prose mentioning the tag still pass.
_is_skills_command_tag() {
    local pattern='^[[:space:]]*<skills[[:space:]]+show[[:space:]]+[A-Za-z0-9._/-]+>[[:space:]]*$'
    [[ "$1" =~ $pattern ]]
}
deferred_request=""
if _is_skills_command_tag "$reply"; then
    deferred_request=$(printf '%s' "$trigger_content" | tr '\r\n' '  ')
    [[ -n "$deferred_request" ]] || deferred_request="Respond to $msg_from's message."
    reply=""
    printf '  model returned a skills command tag — deferring to the mind\n' >&2
fi
_defer_lines=$(printf '%s' "$reply" | grep -E '^[[:space:]]*DEFER:' || true)
if [[ -n "$_defer_lines" || -n "$deferred_request" ]]; then
    while IFS= read -r _dl; do
        _dl=$(printf '%s' "$_dl" | sed -E 's/^[[:space:]]*DEFER:[[:space:]]*//;s/[[:space:]]+$//')
        [[ -n "$_dl" ]] || continue
        if [[ -z "$deferred_request" ]]; then
            deferred_request="$_dl"
        elif [[ "$deferred_request" == "$_dl"* && ${#_dl} -lt ${#deferred_request} ]]; then
            deferred_request="$_dl"
        fi
    done <<< "$_defer_lines"
    # The handoff and every later restatement ride the redacted form; the
    # original message step (its id is quoted in the action) stays the record.
    deferred_request=$(printf '%s' "$deferred_request" | _redact_card)
    # grep -v exits 1 when it drops every line (a bare DEFER); under pipefail
    # that must not kill the step.
    reply=$(printf '%s' "$reply" | grep -vE '^[[:space:]]*DEFER:' | sed '/./,$!d' || true)
    # The un-glued shape leaves the holding sentence twice (before and after
    # the DEFER); send a repeated non-blank line once.
    reply=$(printf '%s\n' "$reply" | awk '!/[^[:space:]]/ || !seen[$0]++' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
    if [[ -z "$reply" ]] || _is_skills_command_tag "$reply"; then
        reply="Let me look into that and get back to you."
    fi
    printf '  deferring to the mind: %s\n' "$deferred_request" >&2
    jq -nc --arg source "$THINKER_NAME" --arg trigger "$trigger_step_id" \
        --arg person "$msg_from" --arg request "$deferred_request" \
        '{type:"action",
          content:("Pending request from " + $person + ": " + $request
                   + ". The responder told them I would get back to them. Do the work, then deliver with: chat reply --follow-up --reply-to "
                   + $trigger + " " + $person + " \"<result>\" and append an observation with --field resolves=" + $trigger),
          source:$source, person:$person, request:$request}
         + (if $trigger == "" then {} else {trigger_step: $trigger} end)' \
        | traj append >/dev/null || true
fi

# Whatever path led here, a reply that still looks like the structured
# object is not a message; the person would read raw JSON.
if printf '%s' "$reply" | head -n 1 | grep -qE '^[[:space:]]*\{[[:space:]]*"action"'; then
    printf '  reply is a raw action object — not sending\n' >&2
    _obs "reply failed: the model's reply to $msg_from was a raw JSON object, so nothing was sent. Reply to them yourself. Their message was: $trigger_excerpt" reply-failed "$(_fail_metrics parse)"
    exit 0
fi

# A reply that is tool-call markup is the model trying to act, not talk
# (Nemotron 3 Ultra: "<function=skills>..." sent to a DM on 2026-09-15).
# Never send it; surface it like a failed reply so the mind can answer.
if printf '%s' "$reply" | head -n 1 | grep -qE '^[[:space:]]*<(function|tool_call|parameter|invoke)[=> ]'; then
    printf '  model returned tool-call markup instead of a reply — not sending\n' >&2
    _obs "reply failed: the model answered $msg_from with tool-call markup instead of a message, so nothing was sent. Reply to them yourself. Their message was: $trigger_excerpt" reply-failed "$(_fail_metrics markup)"
    exit 0
fi

# What we send back never needs card digits: the sender has their own card,
# and this text also lands in the log as a message step. Dates, times, and
# confirmation numbers pass through untouched.
reply=$(printf '%s' "$reply" | _redact_card)

reply_args=()
[[ -n "$trigger_step_id" ]] && reply_args+=(--reply-to "$trigger_step_id")
if [[ -n "$reply" ]] && printf '%s' "$reply" | chat reply ${reply_args[@]+"${reply_args[@]}"} "$msg_from"; then
    _extra=$(_finish_metrics)
    _extra=$(printf '%s' "$_extra" | jq -c --argjson s "$structured" --arg p "$_parse" '. + {structured: ($s == 1), parse: $p}')
    if [[ -n "$deferred_request" ]]; then
        _extra=$(printf '%s' "$_extra" | jq -c --arg r "$deferred_request" '. + {deferred: true, request: $r}')
        _obs "Replied to $msg_from with a holding message and handed the mind a pending request: $(printf '%.200s' "$deferred_request")" replied "$_extra"
    else
        _obs "Replied to $msg_from: $(printf '%.200s' "$reply")" replied "$_extra"
    fi
    printf '  [reply -> %s] %s\n' "$msg_from" "$(printf '%s' "$reply" | head -1)"
    _update_person_notes_async
    exit 0
fi

# Reply failed — surface it so the monolith can pick it up.
printf '  reply failed — appending failure observation\n' >&2
_kind=send
[[ -n "$reply" ]] || _kind=empty
_obs "reply failed: could not send a reply to $msg_from (empty model output or chat error — see responder log). Their message was: $trigger_excerpt" reply-failed "$(_fail_metrics "$_kind")"
