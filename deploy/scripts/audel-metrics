#!/usr/bin/env bash
# deploy/scripts/audel-metrics — reply-latency and run-shape metrics for Audel.
#
# Usage: deploy/scripts/audel-metrics [--cached] [--json]
#
# Computes, from the box's mind log: reply latency split by reply path (fast
# path vs inside a run) and by whether the message arrived while a run was in
# progress, run lengths, duplicate-reply counts, and a per-day usage series
# (messages in/out, model calls, tokens in/out/thinking, runs, steps) plus
# token totals per model — the "how is usage evolving" view. Tokens come from
# the identity's llm usage ledger (usage/llm.jsonl, every bin/llm call) on the
# days it covers, and from the tokens bin/shellm stamps on reasoning steps
# (shellm runs only) on days before the ledger existed. Aggregates on the box
# (SSM output is capped at 24KB), caches the data in .metrics/, keeps a dated
# JSON snapshot next to the cache, and prints a plain-text report. Run it
# before a change to freeze a baseline, and again after to compare.
#
# --cached   re-render from the last pull, no AWS calls
# --json     print the raw JSON instead of the report
# --html     also render an HTML chart page (reply-latency ECDFs) and open it
#
# Identity defaults to audel; override with SHELLM_METRICS_IDENTITY.

export SHELLM_TF_STACK="${SHELLM_TF_STACK:-terraform-slack}"
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

IDENT="${SHELLM_METRICS_IDENTITY:-audel}"
OUT_DIR="$REPO_ROOT/.metrics"
DATA="$OUT_DIR/$IDENT-metrics.json"

cached=0 raw_json=0 html=0
for arg in "$@"; do
    case "$arg" in
        --cached)  cached=1 ;;
        --json)    raw_json=1 ;;
        --html)    html=1 ;;
        -h|--help) sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown flag: $arg (see --help)" ;;
    esac
done

require_tools python3
mkdir -p "$OUT_DIR"

if [[ "$cached" -eq 0 ]]; then
    require_tools terraform aws jq
    require_state
    require_aws

    # The box-side extractor: one pass over the identity's root trajectory.
    # Everything is aggregated here because the payload has to fit the 24KB
    # SSM cap. What it computes:
    #   - one record per inbound message: reply latency, which path replied
    #     (fast = no run_id on the reply, in-run = run_id present), whether
    #     the message arrived inside a run's span, whether a dispatcher
    #     feedback marker exists for it (the mid-run injection change; zero
    #     before that change ships), and how many stamped replies it got.
    #   - run shapes: iterations (reasoning steps per run_id) and wall clock,
    #     as percentiles. A run's span ends at its final step when one
    #     exists — steps appended later with an inherited run_id are Audel's
    #     background processes, not the run.
    #   - llm_s/exec_s duration percentiles, once bin/shellm stamps them.
#   - per UTC day: messages in/out, model calls, tokens in/out/thinking,
#     runs started, reasoning steps, log rows; token totals per model.
#   - output budget (design/output_budget_and_tool_cull.md): per day, shell
#     outputs with their true size (stdout_bytes on spilled steps, else the
#     inline length), how many fit 2K and 8K whole, the bytes a 2K and an 8K
#     render would show, and read steps (sed/cat/head/tail/nl on a file path)
#     that re-read a path already read earlier in the same run.
#     Calls/tokens per day come from the llm ledger when it has at least
#     as many calls as the stamps that day (a complete ledger is a superset;
#     model on each line), else from the reasoning-step stamps (model taken
#     from the run's shellm-run row via run_id). Same rule as
#     web/src/headlong_web/usage.py.
#   - related memories (design/related_memories.md): per day, wakes whose
#     prompt carried a "Related memories" section, names shown, distinct
#     names, repeats from the previous wake, names the run then opened
#     (any command in that run naming the memory), names edited or
#     forgotten within a day of being shown, `mem search` commands, and the
#     section's bytes. The judged relevance sample is deploy/scripts/audel-recall-judge.
#   - model tiers (design/monolith_backoff.md, second lever): per day and
#     tier, runs, runs with visible work, failed runs, requests resolved,
#     ledger calls and tokens (in, cached, out, thinking) per model. A run's
#     tier is read off the wake reason on its shellm-run row: "request" when
#     it ends in /request (MONOLITH_REQUEST_MODEL served it), else
#     "reactive" or "think" by the wake mode (the pre-split proxy). Ledger
#     calls whose run_id is not a monolith run (responder, rollups, nested
#     runs) are "other". Requests: every responder deferral (action with a
#     trigger_step) by the day it was made, how many an observation with
#     resolves= closed, the hours that took, and which tier closed them.
    onbox_script="IDENT_DIR=/opt/shellm/app/.identities/$IDENT
$(cat <<'ONBOX'
set -euo pipefail
[ -d "$IDENT_DIR" ] || { echo "no identity dir on box: $IDENT_DIR" >&2; exit 1; }
python3 - "$IDENT_DIR" <<'PYEOF'
import base64, bisect, glob, gzip, json, os, re, sys
from datetime import datetime, timezone

ident_dir = sys.argv[1]
ident = os.path.basename(ident_dir.rstrip("/"))

def log_path():
    try:
        with open(os.path.join(ident_dir, "info.txt"), encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("root_trajectory="):
                    root = line.split("=", 1)[1].strip()
                    hits = glob.glob(os.path.join(ident_dir, "trajectories", root[:8] + "-*", "trajectory.jsonl"))
                    if hits:
                        return hits[0]
    except OSError:
        pass
    hits = sorted(glob.glob(os.path.join(ident_dir, "trajectories", "*-root", "trajectory.jsonl")))
    return hits[0] if hits else None

path = log_path()
if not path:
    sys.stderr.write("no root trajectory found under " + ident_dir + "\n")
    sys.exit(1)

OFFSET_FIX = re.compile(r"([+-][0-9]{2})([0-9]{2})$")

def epoch(ts):
    ts = ts.strip()
    if ts.endswith("Z"):
        ts = ts[:-1] + "+00:00"
    ts = OFFSET_FIX.sub(r"\1:\2", ts)
    dt = datetime.fromisoformat(ts)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.timestamp()

def pct(values):
    if not values:
        return None
    vs = sorted(values)
    def at(p):
        return round(vs[int(round(p / 100.0 * (len(vs) - 1)))], 1)
    return {"n": len(vs), "p50": at(50), "p90": at(90), "p95": at(95), "max": round(vs[-1], 1)}

inbound = []            # (step_id, ts, sender)
outgoing = []           # (ts, to, reply_to, in_run)
runs = {}               # run_id -> [first_ts, last_ts, final_ts, n_reasoning]
fb_marked = set()       # inbound step_ids with a dispatcher feedback marker
fb_events = []          # (trigger_step_id, feedback_ts)
run_appends = []        # ts of every reasoning/shell-output append (for
                        # locating the iteration boundary after an injection)
llm_s, exec_s = [], []
in_tok, out_tok, think_tok = [], [], []
run_model = {}          # run_id -> model (from the shellm-run row)
daily = {}              # "YYYY-MM-DD" -> counters (calls/tokens = stamps)
day_models = {}         # "YYYY-MM-DD" -> model -> {calls, in, out, think} (stamps)
ledger_daily = {}       # "YYYY-MM-DD" -> {calls, in, out, think, models}
skipped = 0
total = 0
ledger_rows = 0

DAY_KEYS = ("rows", "in_msg", "out_msg", "runs", "reasoning", "calls", "in", "out", "think", "bf",
            "ctx_n", "ctx_zero",
            "outs", "whole2k", "whole8k", "out_true", "out_2k", "out_8k", "reads", "rereads",
            "rel_wakes", "rel_shown", "rel_repeat", "rel_fetched", "rel_fixed", "rel_bytes", "mem_searches")
# Related memories: the wake prompt's section is a header line starting
# "Related memories (" followed by "- <name> [type, age]: ..." lines up to a
# blank line. A name is "fetched" when a later command in the same run
# names it (mem show, cat of the file, anything), "fixed" when a mem edit or
# mem forget names it (or a prefix of it) within a day of it being shown.
RE_REL_LINE = re.compile(r"^- (\S+) \[", re.M)
RE_MEM_SEARCH = re.compile(r"(^|[;&|(]\s*)mem search\b", re.M)
RE_HEREDOC = re.compile(r"<<-?\s*['\"]?(\w+)['\"]?[^\n]*\n.*?\n\s*\1\s*$", re.S | re.M)
RE_QUOTED = re.compile(r"'[^'\n]*'|\"[^\"\n]*\"")


def command_text(cmd):
    """The parts of a shell step that can be commands: heredoc bodies and quoted
    strings are dropped, so a note that says `mem search grep = 0` or a grep
    pattern `'traj|mem search'` does not count as running mem search (on
    2026-09-04 that inflated the count from 2 to 616)."""
    return RE_QUOTED.sub("''", RE_HEREDOC.sub("<<HEREDOC", cmd))
RE_MEM_FIX = re.compile(r"(^|[;&|]\s*)mem (?:edit|forget) (\S+)", re.M)
RE_MEM_FIX_LINE = re.compile(r"^.*\bmem (?:edit|forget)\b.*$", re.M)
def related_names(content):
    i = content.find("\nRelated memories (")
    if i < 0:
        return set(), 0
    block = content[i + 1:]
    j = block.find("\n\n")
    block = block if j < 0 else block[:j]
    return set(RE_REL_LINE.findall(block)), len(block)
# Output budget: a read step is a reasoning step whose command has a line
# starting with one of READ_CMDS naming a file (a token with an extension);
# it is a re-read when any of those paths was read earlier in the same run.
READ_CMDS = ("sed", "cat", "head", "tail", "nl", "view", "less")
PATH_RE = re.compile(r"(?<![\w@])((?:[\w.~-]+/)*[\w-]+\.[A-Za-z0-9]{1,6})(?![\w/])")
run_reads = {}          # run_id -> set of paths read so far
rel_by_run = {}         # run_id -> names shown in that wake's prompt
rel_prev = set()        # names shown in the previous wake (repeat rate)
rel_recent = {}         # name -> ts last shown (for the fixed-within-a-day rate)
rel_fetched_seen = set(); rel_fixed_seen = set()
day_distinct = {}       # day -> set of names shown
TOK = ("calls", "in", "out", "think", "bf")
TIER_DAYS = 14          # payload budget: tiers/requests cover the last N days only
run_tier = {}           # run_id -> "request" | "reactive" | "think"
run_day = {}            # run_id -> day of the shellm-run row
run_work = {}           # run_id -> {"visible": bool, "error": bool, "resolved": n}
deferrals = {}          # trigger_step -> ts the responder deferred it
resolved_at = {}        # trigger_step -> (ts, run_id) of the resolving observation
tier_daily = {}         # day -> tier -> {"runs","work","err","resolved","models":{model:{calls,in,cache,out,think}}}
TTOK = ("calls", "in", "cache", "out", "think")

def tier_of(day, tier):
    return tier_daily.setdefault(day, {}).setdefault(tier, {"runs": 0, "work": 0, "err": 0, "resolved": 0, "models": {}})

# Responder context metrics (design/conversation_memory.md, part 6): every
# decision observation the responder writes carries context_msgs (earlier
# messages with that person it had in the prompt) and gap_s (seconds since
# the previous message exchanged with them; absent on first contact).
# "Forgot" = context_msgs 0 while a previous exchange within 48h existed.
CTX_BUCKETS = (("<2m", 0, 120), ("2-15m", 120, 900), ("15-60m", 900, 3600),
               ("1-6h", 3600, 21600), ("6-48h", 21600, 172800))
ctx_rows = []   # (ts, context_msgs, gap_s or None, decision)
rsp_rows = []   # (ts, decision, failure or None, llm_ms or None, served_by or None, truncated, timed_out, out_tok or None)

def day_key(ts):
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%d")

def day_of(ts):
    return daily.setdefault(day_key(ts), dict.fromkeys(DAY_KEYS, 0))

with open(path, encoding="utf-8", errors="replace") as fh:
    for line in fh:
        line = line.strip()
        if not line:
            continue
        total += 1
        try:
            step = json.loads(line)
        except ValueError:
            skipped += 1
            continue
        t = step.get("type") or ""
        try:
            ts = epoch(step.get("ts") or "")
        except (ValueError, TypeError):
            skipped += 1
            continue
        rid = step.get("run_id") or ""
        dd = day_of(ts)
        dd["rows"] += 1
        if t == "prompt":
            names, nbytes = related_names(step.get("content") or "")
            if names:
                dd["rel_wakes"] += 1
                dd["rel_shown"] += len(names)
                dd["rel_repeat"] += len(names & rel_prev)
                dd["rel_bytes"] += nbytes
                rel_prev = names
                day_distinct.setdefault(day_key(ts), set()).update(names)
                if rid:
                    rel_by_run[rid] = names
                for nm in names:
                    rel_recent[nm] = ts
        if t == "shellm-run":
            dd["runs"] += 1
            # the run's step_id is the run_id its reasoning/final steps carry
            if step.get("step_id"):
                run_model[step["step_id"]] = str(step.get("model") or "?")
                w = str(step.get("wake") or "")
                tier = "request" if w.endswith("/request") else ("reactive" if w.startswith("reactive") else "think")
                run_tier[step["step_id"]] = tier
                run_day[step["step_id"]] = day_key(ts)
                tier_of(day_key(ts), tier)["runs"] += 1
        if rid and t not in ("shellm-run", "trajectory"):
            r = runs.setdefault(rid, [ts, ts, None, 0])
            r[0] = min(r[0], ts)
            r[1] = max(r[1], ts)
            if t == "final" and r[2] is None:
                r[2] = ts
            elif t == "reasoning":
                r[3] += 1
        if rid and rid in run_tier:
            rw = run_work.setdefault(rid, {"visible": False, "error": False, "resolved": 0})
            if t in ("action", "observation", "merge", "message"):
                rw["visible"] = True
            elif t == "error":
                rw["error"] = True
            if t == "observation" and step.get("resolves"):
                rw["resolved"] += 1
        if t == "observation" and step.get("resolves") and step["resolves"] not in resolved_at:
            resolved_at[step["resolves"]] = (ts, rid)
        if t == "action" and step.get("source") == "responder" and step.get("trigger_step"):
            deferrals.setdefault(step["trigger_step"], ts)
        if t == "message":
            frm, to = step.get("from") or "", step.get("to") or ""
            if to == ident and frm and frm != ident:
                inbound.append((step.get("step_id") or "", ts, frm))
                dd["in_msg"] += 1
            elif frm == ident and to and to != ident:
                outgoing.append((ts, to, step.get("reply_to") or "", bool(rid)))
                dd["out_msg"] += 1
        elif t == "feedback" and step.get("source") == "dispatcher" and step.get("trigger_step"):
            fb_marked.add(step["trigger_step"])
            fb_events.append((step["trigger_step"], ts))
        elif (t == "observation" and step.get("source") == "responder"
              and step.get("decision") in ("replied", "no-reply", "reply-failed")):
            # Every decision, with what the reply call did (llm_ms, served_by,
            # truncated, timed_out, failure kind) once the 2026-09-22 step is
            # deployed; older observations count as decisions with no call data.
            rsp_rows.append((
                ts, step.get("decision"), step.get("failure"),
                step.get("llm_ms") if isinstance(step.get("llm_ms"), (int, float)) else None,
                step.get("served_by") if isinstance(step.get("served_by"), str) else None,
                bool(step.get("truncated")), bool(step.get("timed_out")),
                step.get("out_tok") if isinstance(step.get("out_tok"), int) else None,
            ))
        if (t == "observation" and step.get("source") == "responder"
              and step.get("decision") in ("replied", "no-reply")
              and isinstance(step.get("context_msgs"), int)):
            gap = step.get("gap_s")
            gap = gap if isinstance(gap, (int, float)) else None
            ctx_rows.append((ts, step["context_msgs"], gap, step["decision"]))
            if gap is not None and gap < 172800:
                dd["ctx_n"] += 1
                if step["context_msgs"] == 0:
                    dd["ctx_zero"] += 1
        elif t in ("reasoning", "shell-output"):
            if rid:
                run_appends.append(ts)
            if t == "shell-output":
                sz = step.get("stdout_bytes")
                if not isinstance(sz, int):
                    sz = len(step.get("stdout") or "")
                dd["outs"] += 1
                dd["out_true"] += sz
                dd["out_2k"] += min(sz, 2048)
                dd["out_8k"] += min(sz, 8192)
                if sz <= 2048:
                    dd["whole2k"] += 1
                if sz <= 8192:
                    dd["whole8k"] += 1
            if t == "reasoning":
                dd["reasoning"] += 1
                cmd = step.get("cmd") or ""
                if RE_MEM_SEARCH.search(command_text(cmd)):
                    dd["mem_searches"] += 1
                read_cmd = RE_MEM_FIX_LINE.sub("", cmd)   # an edit or forget is a fix, not a read
                for nm in rel_by_run.get(rid, ()):
                    if nm in read_cmd and (rid, nm) not in rel_fetched_seen:
                        rel_fetched_seen.add((rid, nm))
                        dd["rel_fetched"] += 1
                for m in RE_MEM_FIX.finditer(cmd):
                    target = m.group(2)
                    for full, t0 in rel_recent.items():
                        if full.startswith(target) and ts - t0 < 86400 and full not in rel_fixed_seen:
                            rel_fixed_seen.add(full)
                            dd["rel_fixed"] += 1
                paths = set()
                for ln in (step.get("cmd") or "").split("\n"):
                    tok = ln.strip().split(" ", 1)[0] if ln.strip() else ""
                    if tok in READ_CMDS:
                        paths.update(PATH_RE.findall(ln))
                if paths:
                    dd["reads"] += 1
                    seen = run_reads.setdefault(rid or step.get("step_id") or "", set())
                    if paths & seen:
                        dd["rereads"] += 1
                    seen |= paths
                if isinstance(step.get("llm_s"), (int, float)):
                    llm_s.append(step["llm_s"])
                bm = day_models.setdefault(day_key(ts), {}).setdefault(run_model.get(rid, "?"), dict.fromkeys(TOK, 0))
                stamped = False
                for key, dest, short in (("in_tok", in_tok, "in"), ("out_tok", out_tok, "out"), ("think_tok", think_tok, "think")):
                    if isinstance(step.get(key), (int, float)):
                        dest.append(step[key])
                        dd[short] += int(step[key])
                        bm[short] += int(step[key])
                        stamped = True
                if stamped:
                    dd["calls"] += 1
                    bm["calls"] += 1
            elif isinstance(step.get("exec_s"), (int, float)):
                exec_s.append(step["exec_s"])

# The llm usage ledger: one line per successful bin/llm call from any caller
# (shellm runs, the responder fast path, other thinkers). Appended by bin/llm
# unconditionally, so it is the complete spend on the days it covers.
#
# shellm stops reading a response the moment its first code block closes
# (SHELLM_STOP_AT_FENCE), so for those calls the provider's usage event never
# arrives: bin/llm writes the row with out_tok estimated from bytes and NO
# in_tok (2,184 of 3,993 grok calls on 2026-09-04). Summing metered in_tok
# alone halved the day's input spend. Backfill: the prompt inside one run is
# the same conversation growing by a step at a time, so a cut call's input is
# taken from the nearest metered call of the same run (cache_tok along with
# it); a run with no metered call at all takes the day's median for the model.
ledger_path = os.path.join(ident_dir, "usage", "llm.jsonl")
ledger_recs = []
try:
    with open(ledger_path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            ledger_rows += 1
            try:
                rec = json.loads(line)
                lts = epoch(rec.get("ts") or "")
            except (ValueError, TypeError, AttributeError):
                continue
            ledger_recs.append((lts, rec))
except OSError:
    pass
ledger_recs.sort(key=lambda x: x[0])
_by_run = {}
for i, (lts, rec) in enumerate(ledger_recs):
    _by_run.setdefault((rec.get("run_id"), rec.get("model")), []).append(i)
_day_model_in = {}
for lts, rec in ledger_recs:
    if isinstance(rec.get("in_tok"), (int, float)):
        _day_model_in.setdefault((day_key(lts), rec.get("model")), []).append(int(rec["in_tok"]))
for key, idxs in _by_run.items():
    metered = [i for i in idxs if isinstance(ledger_recs[i][1].get("in_tok"), (int, float))]
    for i in idxs:
        lts, rec = ledger_recs[i]
        if isinstance(rec.get("in_tok"), (int, float)) or not isinstance(rec.get("out_tok"), (int, float)):
            continue
        if metered and key[0] is not None:
            j = min(metered, key=lambda k: abs(k - i))
            rec["in_tok"] = ledger_recs[j][1]["in_tok"]
            if isinstance(ledger_recs[j][1].get("cache_tok"), (int, float)):
                rec["cache_tok"] = ledger_recs[j][1]["cache_tok"]
        else:
            pool = sorted(_day_model_in.get((day_key(lts), rec.get("model")), []))
            if not pool:
                continue
            rec["in_tok"] = pool[len(pool) // 2]
        rec["_backfilled"] = True
for lts, rec in ledger_recs:
    ld = ledger_daily.setdefault(day_key(lts), dict.fromkeys(TOK, 0))
    lm = ld.setdefault("models", {}).setdefault(str(rec.get("model") or "?"), dict.fromkeys(TOK, 0))
    stamped = False
    for key, short in (("in_tok", "in"), ("out_tok", "out"), ("think_tok", "think")):
        if isinstance(rec.get(key), (int, float)):
            ld[short] += int(rec[key])
            lm[short] += int(rec[key])
            stamped = True
    if stamped:
        ld["calls"] += 1
        lm["calls"] += 1
        if rec.get("_backfilled"):
            ld["bf"] += 1
            lm["bf"] += 1
        rid = rec.get("run_id") or ""
        tm = tier_of(day_key(lts), run_tier.get(rid, "other"))["models"].setdefault(
            str(rec.get("model") or "?"), dict.fromkeys(TTOK, 0))
        tm["calls"] += 1
        for key, short in (("in_tok", "in"), ("cache_tok", "cache"), ("out_tok", "out"), ("think_tok", "think")):
            if isinstance(rec.get(key), (int, float)):
                tm[short] += int(rec[key])

# Per day, the ledger wins when it has at least as many calls as the stamps
# (a complete ledger is a superset of them); otherwise the stamps stand (days
# before the ledger existed, the part-day it started on). by_model sums the
# winning source per day.
by_model = {}
ledger_since = None
for d in sorted(set(daily) | set(ledger_daily)):
    dd = daily.setdefault(d, dict.fromkeys(DAY_KEYS, 0))
    ld = ledger_daily.get(d)
    if ld and ld["calls"] > 0 and ld["calls"] >= dd["calls"]:
        for k in TOK:
            dd[k] = ld[k]
        dd["source"] = "ledger"
        models = ld["models"]
        if ledger_since is None:
            ledger_since = d
    else:
        dd["source"] = "mindlog"
        models = day_models.get(d, {})
    for m, v in models.items():
        bm = by_model.setdefault(m, dict.fromkeys(TOK, 0))
        for k in TOK:
            bm[k] += v[k]

# Run spans for busy-at-arrival, sorted for bisect. End at the final step
# when the run has one, else at the last step seen with that run_id.
spans = sorted((r[0], (r[2] if r[2] is not None else r[1])) for r in runs.values())
starts = [s[0] for s in spans]
max_ends = []
for _, end in spans:
    max_ends.append(max(end, max_ends[-1] if max_ends else end))

def busy_at(ts):
    i = bisect.bisect_right(starts, ts) - 1
    return i >= 0 and max_ends[i] >= ts

outgoing.sort()
by_reply_to = {}
for o in outgoing:
    if o[2]:
        by_reply_to.setdefault(o[2], []).append(o)

records = []            # [latency_s|None, path, busy, marked, pairing, n_stamped]
for sid, ts, sender in inbound:
    stamped = by_reply_to.get(sid, [])
    reply, pairing = None, "none"
    if stamped:
        reply, pairing = stamped[0], "stamped"
    else:
        for o in outgoing:
            if o[0] > ts and o[1] == sender and not o[2]:
                reply, pairing = o, "positional"
                break
    lat = round(reply[0] - ts, 1) if reply and reply[0] >= ts else None
    p = ("in_run" if reply[3] else "fast") if reply else ""
    records.append([lat, p, busy_at(ts), sid in fb_marked, pairing, len(stamped)])

out_counts = {
    "reply_fast": sum(1 for o in outgoing if o[2] and not o[3]),
    "reply_in_run": sum(1 for o in outgoing if o[2] and o[3]),
    "other_in_run": sum(1 for o in outgoing if not o[2] and o[3]),
    "other_fast": sum(1 for o in outgoing if not o[2] and not o[3]),
}

# Injection events: decompose each mid-run reply chain. The boundary is the
# first run append (reasoning/shell-output) after the feedback — the moment
# the in-flight model call + command finished and the note became visible.
run_appends.sort()
by_id = {i: (t, s) for (i, t, s) in inbound}
injections = []
for trig, fb_ts in fb_events:
    if trig not in by_id:
        continue
    msg_ts = by_id[trig][0]
    reply = next((o for o in outgoing if o[2] == trig), None)
    j = bisect.bisect_right(run_appends, fb_ts)
    bnd = run_appends[j] if j < len(run_appends) else None
    ev = {
        "when": datetime.fromtimestamp(msg_ts, timezone.utc).strftime("%m-%d %H:%M"),
        "inject_ms": int(round((fb_ts - msg_ts) * 1000)),
        "wait_s": None, "model_s": None, "total_s": None, "path": "none",
    }
    if reply:
        r_ts, in_run = reply[0], reply[3]
        ev["total_s"] = round(r_ts - msg_ts, 1)
        ev["path"] = "inline" if in_run else "fast"
        if in_run and bnd is not None and bnd <= r_ts:
            ev["wait_s"] = round(bnd - fb_ts, 1)
            ev["model_s"] = round(r_ts - bnd, 1)
    injections.append(ev)
real_runs = [r for r in runs.values() if r[3] > 0]

# Responder context by gap bucket, the same table shape as the design doc.
ctx_buckets = []
for label, lo, hi in CTX_BUCKETS:
    rows = [r for r in ctx_rows if r[2] is not None and lo <= r[2] < hi]
    ctx_buckets.append({
        "gap": label, "n": len(rows),
        "forgot": sum(1 for r in rows if r[1] == 0),
        "median_ctx": pct([r[1] for r in rows]).get("p50") if rows else None,
    })
# Responder calls: failures by kind, call latency, and the upstream host
# (served_by) each call landed on, with that host's truncation and timeout
# counts. One model id on OpenRouter is two dozen hosts at different speeds.
_with_call = [r for r in rsp_rows if r[3] is not None]
_hosts = {}
for r in _with_call:
    h = _hosts.setdefault(r[4] or "(unknown)", {"calls": 0, "truncated": 0, "timed_out": 0, "ms": []})
    h["calls"] += 1
    h["truncated"] += 1 if r[5] else 0
    h["timed_out"] += 1 if r[6] else 0
    h["ms"].append(r[3])
_fail_kinds = {}
for r in rsp_rows:
    if r[1] == "reply-failed":
        _fail_kinds[r[2] or "(unspecified)"] = _fail_kinds.get(r[2] or "(unspecified)", 0) + 1
responder_calls = {
    "decisions": len(rsp_rows),
    "replied": sum(1 for r in rsp_rows if r[1] == "replied"),
    "no_reply": sum(1 for r in rsp_rows if r[1] == "no-reply"),
    "failed": sum(1 for r in rsp_rows if r[1] == "reply-failed"),
    "failures": _fail_kinds,
    "with_call_data": len(_with_call),
    "since": (datetime.fromtimestamp(min(r[0] for r in _with_call), timezone.utc).strftime("%Y-%m-%d")
              if _with_call else None),
    "llm_ms": pct([r[3] for r in _with_call]) if _with_call else {},
    "out_tok": pct([r[7] for r in _with_call if r[7] is not None]) if _with_call else {},
    "hosts": sorted(
        ({"host": k, "calls": v["calls"], "truncated": v["truncated"], "timed_out": v["timed_out"],
          "llm_ms": pct(v["ms"])} for k, v in _hosts.items()),
        key=lambda h: -h["calls"]),
}
# Fold the per-run work flags into the tier of the run's day, then keep only
# the last TIER_DAYS days (the SSM payload cap).
for rid, rw in run_work.items():
    tv = tier_of(run_day[rid], run_tier[rid])
    tv["work"] += 1 if rw["visible"] else 0
    tv["err"] += 1 if rw["error"] else 0
    tv["resolved"] += rw["resolved"]
tiers = {d: tier_daily[d] for d in sorted(tier_daily)[-TIER_DAYS:]}
requests = {}           # deferral day -> {"n","resolved","hours":[...],"by":{tier:n}}
for trig, dts in deferrals.items():
    rq = requests.setdefault(day_key(dts), {"n": 0, "resolved": 0, "hours": [], "by": {}})
    rq["n"] += 1
    hit = resolved_at.get(trig)
    if hit and hit[0] >= dts:
        rq["resolved"] += 1
        rq["hours"].append(round((hit[0] - dts) / 3600.0, 2))
        by = run_tier.get(hit[1] or "", "other")
        rq["by"][by] = rq["by"].get(by, 0) + 1
for rq in requests.values():
    rq["hours"] = pct(rq["hours"]) or {}
requests = {d: requests[d] for d in sorted(requests)[-TIER_DAYS:]}
context = {
    "decisions": len(ctx_rows),
    "first_contact": sum(1 for r in ctx_rows if r[2] is None),
    "since": (datetime.fromtimestamp(min(r[0] for r in ctx_rows), timezone.utc).strftime("%Y-%m-%d")
              if ctx_rows else None),
    "buckets": ctx_buckets,
}
out = {
    "identity": ident,
    "log": path,
    "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "log_lines": total,
    "skipped": skipped,
    "inbound": len(inbound),
    "outgoing": out_counts,
    "records": records,
    "runs": {
        "count": len(real_runs),
        "iterations": pct([r[3] for r in real_runs]),
        "wall_s": pct([(r[2] if r[2] is not None else r[1]) - r[0] for r in real_runs]),
    },
    "durations": {"llm_s": pct(llm_s), "exec_s": pct(exec_s)},
    "tokens": {
        "in_tok": pct(in_tok), "out_tok": pct(out_tok), "think_tok": pct(think_tok),
        "totals": {"in": sum(in_tok), "out": sum(out_tok), "think": sum(think_tok)},
    },
    "injections": injections,
    "context": context,
    "responder_calls": responder_calls,
    "daily": [[d, daily[d]] for d in sorted(daily)],
    "rel_distinct": {d: len(v) for d, v in day_distinct.items()},
    "by_model": by_model,
    "ledger": {"rows": ledger_rows, "since": ledger_since},
    "tiers": tiers,
    "requests": requests,
}
blob = base64.b64encode(gzip.compress(json.dumps(out, separators=(",", ":")).encode())).decode()
if len(blob) > 23000:
    sys.stderr.write("warning: payload " + str(len(blob)) + "B is near the 24KB SSM cap\n")
print("AUDEL_METRICS_BEGIN")
for i in range(0, len(blob), 76):
    print(blob[i : i + 76])
print("AUDEL_METRICS_END")
PYEOF
ONBOX
)"

    info "pulling $IDENT metrics from the box ($SHELLM_TF_STACK)..."
    payload=$(run_script_on_box "$onbox_script")
    b64=$(awk '/^AUDEL_METRICS_BEGIN$/{f=1;next} /^AUDEL_METRICS_END$/{f=0} f' <<<"$payload")
    [[ -n "$b64" ]] || die "no data in box output:
$payload"
    printf '%s' "$b64" | base64 -d | gunzip > "$DATA" || die "payload decode failed"
    snapshot="$OUT_DIR/$IDENT-metrics-$(date -u +%Y%m%d).json"
    cp "$DATA" "$snapshot"
    info "cached $(wc -c < "$DATA" | tr -d ' ') bytes -> $DATA (snapshot: $snapshot)"
else
    [[ -f "$DATA" ]] || die "no cached data at $DATA — run once without --cached"
fi

if [[ "$raw_json" -eq 1 ]]; then
    python3 -m json.tool "$DATA"
    exit 0
fi

if [[ "$html" -eq 1 ]]; then
    HTML="$OUT_DIR/$IDENT-metrics.html"
    python3 "$SCRIPTS_DIR/audel-metrics-render.py" "$DATA" "$HTML"
    command -v open >/dev/null 2>&1 && open "$HTML"
fi

python3 - "$DATA" <<'PYEOF'
import json, sys

d = json.load(open(sys.argv[1]))
recs = d["records"]

def pct(values):
    if not values:
        return None
    vs = sorted(values)
    def at(p):
        return vs[int(round(p / 100.0 * (len(vs) - 1)))]
    return {"n": len(vs), "p50": at(50), "p90": at(90), "p95": at(95), "max": vs[-1]}

def fmt(label, stats):
    if not stats:
        return "  %-28s %5d" % (label, 0)
    return "  %-28s %5d  %7.1f %7.1f %7.1f %8.1f" % (
        label, stats["n"], stats["p50"], stats["p90"], stats["p95"], stats["max"])

def seg(pred):
    return pct([r[0] for r in recs if r[0] is not None and r[4] == "stamped" and pred(r)])

o = d["outgoing"]
print("audel metrics report")
print("identity: %s   generated: %s" % (d["identity"], d["generated"]))
print("log: %s (%d lines, %d skipped)" % (d["log"], d["log_lines"], d["skipped"]))
print()
print("messages")
print("  inbound: %d" % d["inbound"])
print("  outgoing: %d (fast replies %d, in-run replies %d, in-run other %d, other %d)"
      % (sum(o.values()), o["reply_fast"], o["reply_in_run"], o["other_in_run"], o["other_fast"]))
print()
n_stamped = sum(1 for r in recs if r[4] == "stamped")
n_pos = sum(1 for r in recs if r[4] == "positional")
n_none = sum(1 for r in recs if r[4] == "none")
n_dup = sum(1 for r in recs if r[5] >= 2)
print("reply pairing (per inbound message)")
print("  stamped reply: %d   positional only: %d   unanswered: %d" % (n_stamped, n_pos, n_none))
print("  inbound with 2+ stamped replies (duplicates): %d" % n_dup)
print()
print("reply latency, stamped pairs only, seconds")
print("  %-28s %5s  %7s %7s %7s %8s" % ("segment", "n", "p50", "p90", "p95", "max"))
print(fmt("all", seg(lambda r: True)))
print(fmt("fast path", seg(lambda r: r[1] == "fast")))
print(fmt("in-run reply", seg(lambda r: r[1] == "in_run")))
print(fmt("arrived while idle", seg(lambda r: not r[2])))
print(fmt("arrived during a run", seg(lambda r: r[2])))
print(fmt("dispatcher marker present", seg(lambda r: r[3])))
print("  (dispatcher marker = mid-run injection feedback; 0 before that change ships)")
print()
r = d["runs"]
print("runs (run_id groups with at least one reasoning step)")
print("  %-28s %5s  %7s %7s %7s %8s" % ("", "n", "p50", "p90", "p95", "max"))
print(fmt("iterations per run", r["iterations"]))
print(fmt("wall clock seconds", r["wall_s"]))
print()
du = d["durations"]
if du["llm_s"] or du["exec_s"]:
    print("iteration durations, seconds (stamped by bin/shellm)")
    print(fmt("llm call (llm_s)", du["llm_s"]))
    print(fmt("bash execution (exec_s)", du["exec_s"]))
else:
    print("iteration durations: not stamped yet (llm_s/exec_s not in this log)")

tk = d.get("tokens") or {}
if tk.get("in_tok") or tk.get("out_tok"):
    print()
    print("tokens per model call (stamped by bin/llm)")
    print("  %-28s %5s  %7s %7s %7s %8s" % ("", "n", "p50", "p90", "p95", "max"))
    print(fmt("input (in_tok)", tk.get("in_tok")))
    print(fmt("output (out_tok)", tk.get("out_tok")))
    print(fmt("thinking (think_tok)", tk.get("think_tok")))
    tot = tk.get("totals") or {}
    print("  totals: in %s  out %s  thinking %s"
          % tuple("{:,}".format(int(tot.get(k, 0))) for k in ("in", "out", "think")))

led = d.get("ledger") or {}
bym = d.get("by_model") or {}
if bym:
    print()
    if led.get("since"):
        print("tokens per model (llm ledger, every call, from %s; shellm-run stamps only before)" % led["since"])
    else:
        print("tokens per model (shellm-run stamps only; llm ledger has no calls yet)")
    print("  %-32s %6s %13s %12s %12s" % ("model", "calls", "in", "out", "thinking"))
    for m, v in sorted(bym.items(), key=lambda kv: -kv[1]["in"]):
        print("  %-32s %6d %13s %12s %12s" % (m[:32], v["calls"],
              "{:,}".format(v["in"]), "{:,}".format(v["out"]), "{:,}".format(v["think"])))

ctx = d.get("context") or {}
print()
print("responder context (what the responder had of the conversation; design/conversation_memory.md)")
if not ctx.get("decisions"):
    print("  none recorded (the responder stamps context_msgs/gap_s on its decision observations")
    print("   from part 6 of that plan; nothing before that deploy is counted)")
else:
    print("  decisions: %d since %s   first contact (no previous exchange): %d"
          % (ctx["decisions"], ctx.get("since"), ctx.get("first_contact", 0)))
    print("  %-10s %6s %8s %8s %11s" % ("gap", "n", "forgot", "forgot%", "median_ctx"))
    for b in ctx.get("buckets") or []:
        share = ("%d%%" % round(100.0 * b["forgot"] / b["n"])) if b["n"] else "-"
        med = b["median_ctx"] if b["median_ctx"] is not None else "-"
        print("  %-10s %6d %8d %8s %11s" % (b["gap"], b["n"], b["forgot"], share, med))
    print("  (gap = time since the previous message with that person; forgot = the prompt held")
    print("   none of the earlier conversation; median_ctx = earlier messages in the prompt, cap 12)")

rc = d.get("responder_calls") or {}
print()
print("responder calls (every decision; call data from the 2026-09-22 step on)")
if not rc.get("decisions"):
    print("  none recorded")
else:
    fails = ", ".join("%s %d" % (k, v) for k, v in sorted((rc.get("failures") or {}).items(), key=lambda kv: -kv[1])) or "-"
    print("  decisions: %d   replied: %d   no_reply: %d   failed: %d (%s)"
          % (rc["decisions"], rc.get("replied", 0), rc.get("no_reply", 0), rc.get("failed", 0), fails))
    if rc.get("with_call_data"):
        ms = rc.get("llm_ms") or {}
        ot = rc.get("out_tok") or {}
        print("  calls with data: %d since %s   llm_s p50/p90/max: %s/%s/%s   out_tok p50/p90/max: %s/%s/%s"
              % (rc["with_call_data"], rc.get("since"),
                 *(("%.0f" % (ms[k] / 1000.0)) if ms.get(k) is not None else "-" for k in ("p50", "p90", "max")),
                 *((ot[k]) if ot.get(k) is not None else "-" for k in ("p50", "p90", "max"))))
        print("  %-22s %6s %9s %9s %10s" % ("served_by", "calls", "truncated", "timed_out", "llm_s p50"))
        for h in rc.get("hosts") or []:
            p50 = h.get("llm_ms", {}).get("p50")
            print("  %-22s %6d %9d %9d %10s" % (h["host"][:22], h["calls"], h["truncated"], h["timed_out"],
                  ("%.0f" % (p50 / 1000.0)) if p50 is not None else "-"))
        print("  (served_by = the upstream host OpenRouter routed the reply call to; truncated = hit the")
        print("   token cap; timed_out = hit the wall clock cap; llm_s = the reply call alone, not the wake)")

daily = d.get("daily") or []
if daily:
    print()
    print("per day (utc)")
    print("  %-10s %5s %5s %5s %6s %7s %11s %10s %10s %8s" % (
        "day", "in", "out", "runs", "steps", "calls", "tok_in", "tok_out", "tok_think", "forgot"))
    for day, v in daily:
        forgot = ("%d/%d" % (v.get("ctx_zero", 0), v.get("ctx_n", 0))) if v.get("ctx_n") else "-"
        print("  %-10s %5d %5d %5d %6d %7d %11s %10s %10s %8s" % (
            day, v["in_msg"], v["out_msg"], v["runs"], v["reasoning"], v["calls"],
            "{:,}".format(v["in"]), "{:,}".format(v["out"]), "{:,}".format(v["think"]), forgot))
    print("  (in/out = messages; steps = reasoning steps; calls/tok = every llm call on ledger days%s,"
          % (" (from %s)" % led["since"] if led.get("since") else ""))
    print("   shellm-run stamps only on earlier days; forgot = replies with no earlier conversation")
    print("   in the prompt / replies where a previous exchange within 48h existed)")
    bf_calls = sum(v.get("bf", 0) for _, v in daily)
    bf_of = sum(v["calls"] for _, v in daily if v.get("source") == "ledger")
    if bf_calls:
        print("  (tok_in backfills %d of %d ledger calls (%d%%) whose stream shellm cut before the usage"
              % (bf_calls, bf_of, round(100.0 * bf_calls / max(bf_of, 1))))
        print("   event, from the nearest metered call of the same run; those calls are billed in full)")

# Model tiers. Dollar estimates use OpenRouter list prices per million tokens
# (input, cached input, output; read 2026-09-23). out_tok already includes
# thinking. The ledger sees about 70% of billed spend (calls cut at the fence
# are backfilled; nested runs and retries are not), so treat the figure as a
# floor. Unknown model = no estimate.
PRICES = {
    "openai/gpt-6-astra": (10.0, 1.0, 50.0), "openai/gpt-6-astra-pro": (10.0, 1.0, 50.0),
    "xiaomi/mimo-v2.6-pro": (0.435, 0.0036, 0.87),
    "nvidia/nemotron-3-ultra-550b-a55b": (0.6, 0.12, 2.4),
    "x-ai/grok-4.6": (2.0, 0.5, 6.0), "z-ai/glm-5.3": (0.84, 0.156, 2.64), "z-ai/glm-5.2": (0.65, 0.12, 2.04),
    "z-ai/glm-5.3-flash": (0.15, 0.05, 0.5), "deepseek/deepseek-v4-pro-0813": (0.66, 0.022, 1.98),
    "anthropic/claude-sonnet-5": (2.0, 0.2, 10.0), "anthropic/claude-opus-5.5": (4.0, 0.2, 20.0),
    "google/gemini-2.5-flash-lite": (0.1, 0.01, 0.4),
}
def usd(models):
    total, known = 0.0, True
    for m, v in models.items():
        pr = PRICES.get(m)
        if not pr:
            known = False
            continue
        total += ((v["in"] - v["cache"]) * pr[0] + v["cache"] * pr[1] + v["out"] * pr[2]) / 1e6
    return total, known
tiers = d.get("tiers") or {}
if tiers:
    TIER_ORDER = ("request", "reactive", "think", "other")
    def tier_line(label, tier, rows):
        runs = sum(v["runs"] for v in rows); work = sum(v["work"] for v in rows)
        err = sum(v["err"] for v in rows); res = sum(v["resolved"] for v in rows)
        models = {}
        for v in rows:
            for m, mv in v["models"].items():
                acc = models.setdefault(m, dict.fromkeys(("calls", "in", "cache", "out", "think"), 0))
                for k in acc:
                    acc[k] += mv.get(k, 0)
        calls = sum(m["calls"] for m in models.values()); tin = sum(m["in"] for m in models.values())
        cache = sum(m["cache"] for m in models.values()); tout = sum(m["out"] for m in models.values())
        dollars, known = usd(models)
        names = ",".join(sorted(set(m.split("/")[-1][:18] for m in models))) or "-"
        return "  %-11s %-8s %5d %5s %4d %4d %6d %11s %6s %9s %8s  %s" % (
            label, tier, runs, ("%d%%" % round(100.0 * work / runs)) if runs else "-", err, res, calls,
            "{:,}".format(tin), ("%d%%" % round(100.0 * cache / tin)) if tin else "-", "{:,}".format(tout),
            ("$%.2f%s" % (dollars, "" if known else "+")) if models else "-", names)
    print()
    print("model tiers (design/monolith_backoff.md; MONOLITH_REQUEST_MODEL)")
    print("  %-11s %-8s %5s %5s %4s %4s %6s %11s %6s %9s %8s  %s" % (
        "", "tier", "runs", "work", "err", "res", "calls", "tok_in", "cached", "tok_out", "est_usd", "models"))
    days_sorted = sorted(tiers)
    for label, span in (("last 7 days", days_sorted[-7:]), ("prior 7", days_sorted[-14:-7])):
        for tier in TIER_ORDER:
            rows = [tiers[dd][tier] for dd in span if tier in tiers[dd]]
            if rows:
                print(tier_line(label, tier, rows))
        label = ""
    for dd in days_sorted[-7:]:
        for tier in TIER_ORDER:
            if tier in tiers[dd]:
                print(tier_line(dd, tier, [tiers[dd][tier]]))
    print("  (tier from the wake reason on the run row: request = served by MONOLITH_REQUEST_MODEL,")
    print("   reactive/think = wake mode when no request model is set; other = ledger calls outside a")
    print("   monolith run: responder, rollups, nested runs. work = runs that wrote an action,")
    print("   observation, merge or message; err = runs that ended in an error step; res = pending")
    print("   requests resolved; est_usd = OpenRouter list price on ledger tokens, a floor (+ = a")
    print("   model with no price in the table))")
rq = d.get("requests") or {}
if rq:
    print()
    print("requests (responder deferrals by the day they were made)")
    print("  %-12s %5s %9s %8s %8s %8s  %s" % ("day", "made", "resolved", "h_p50", "h_p90", "h_max", "resolved by"))
    for dd in sorted(rq)[-14:]:
        v = rq[dd]; h = v.get("hours") or {}
        by = ", ".join("%s %d" % kv for kv in sorted(v.get("by", {}).items())) or "-"
        print("  %-12s %5d %9d %8s %8s %8s  %s" % (
            dd, v["n"], v["resolved"],
            *(("%.1f" % h[k]) if h.get(k) is not None else "-" for k in ("p50", "p90", "max")), by))
    print("  (resolved = an observation with resolves=<trigger> followed; hours from the deferral to it;")
    print("   resolved by = tier of the run that wrote the observation)")

ob = [(day, v) for day, v in daily if v.get("outs")]
if ob:
    def ob_sum(rows, k):
        return sum(v.get(k, 0) for _, v in rows)
    def ob_line(label, rows):
        outs, reads = ob_sum(rows, "outs"), ob_sum(rows, "reads")
        if not outs:
            return "  %-12s %6d" % (label, 0)
        return "  %-12s %6d %8d%% %8d%% %7d %7d %7d  %6d %7s" % (
            label, outs,
            round(100.0 * ob_sum(rows, "whole2k") / outs), round(100.0 * ob_sum(rows, "whole8k") / outs),
            ob_sum(rows, "out_true") // outs, ob_sum(rows, "out_2k") // outs, ob_sum(rows, "out_8k") // outs,
            reads, ("%d%%" % round(100.0 * ob_sum(rows, "rereads") / reads)) if reads else "-")
    print()
    print("output budget (design/output_budget_and_tool_cull.md)")
    print("  %-12s %6s %9s %9s %7s %7s %7s  %6s %7s" % (
        "", "outs", "whole@2K", "whole@8K", "true_B", "at2K_B", "at8K_B", "reads", "reread"))
    print(ob_line("all days", ob))
    print(ob_line("last 7 days", ob[-7:]))
    for day, v in ob[-14:]:
        print(ob_line(day, [(day, v)]))
    print("  (outs = shell outputs; whole@N = share whose true size fits N bytes; true_B = mean true")
    print("   size, atN_B = mean bytes an N-byte render shows; reads = reasoning steps that read a")
    print("   file with sed/cat/head/tail/nl; reread = share that read a path already read in the run)")

rl = [(day, v) for day, v in daily if v.get("rel_wakes")]
if rl:
    rdist = d.get("rel_distinct") or {}
    def rl_line(label, rows, distinct):
        w, shown = sum(v["rel_wakes"] for _, v in rows), sum(v["rel_shown"] for _, v in rows)
        if not shown:
            return "  %-12s %6d" % (label, w)
        pc = lambda k: "%d%%" % round(100.0 * sum(v.get(k, 0) for _, v in rows) / shown)
        return "  %-12s %6d %6d %8s %7s %8s %6s %8d %7d" % (
            label, w, shown, (str(distinct) if distinct is not None else "-"),
            pc("rel_repeat"), pc("rel_fetched"), pc("rel_fixed"),
            sum(v.get("mem_searches", 0) for _, v in rows), sum(v["rel_bytes"] for _, v in rows) // w)
    print()
    print("related memories (design/related_memories.md)")
    print("  %-12s %6s %6s %8s %7s %8s %6s %8s %7s" % (
        "", "wakes", "shown", "distinct", "repeat", "fetched", "fixed", "searches", "B/wake"))
    print(rl_line("all days", rl, None))
    print(rl_line("last 7 days", rl[-7:], None))
    for day, v in rl[-14:]:
        print(rl_line(day, [(day, v)], rdist.get(day)))
    print("  (wakes = prompts carrying the section; shown = names listed; repeat = share also shown the")
    print("   wake before; fetched = share the run then opened by name; fixed = share edited or forgotten")
    print("   within a day; searches = mem search commands that day; B/wake = section bytes)")

inj = d.get("injections")
print()
print("injection events (message queued behind a busy run)")
if not inj:
    print("  none recorded")
else:
    print("  %-12s %-7s %8s %10s %8s %8s" % ("when (utc)", "path", "total_s", "inject_ms", "wait_s", "model_s"))
    for e in inj:
        print("  %-12s %-7s %8s %10s %8s %8s" % (
            e["when"], e["path"],
            e["total_s"] if e["total_s"] is not None else "-",
            e["inject_ms"],
            e["wait_s"] if e["wait_s"] is not None else "-",
            e["model_s"] if e["model_s"] is not None else "-"))
    print("  (inject = dispatcher wrote the note; wait = in-flight call finishing;")
    print("   model = the call that composed the reply. fast path = replied after run end)")
PYEOF
