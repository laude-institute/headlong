#!/usr/bin/env bash
# deploy/scripts/status — instance state, service health, deployed commit.
#
# Usage: deploy/scripts/status

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

case "${1:-}" in
    -h|--help) sed -n '2,4p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

require_tools terraform aws
require_state
require_aws

state=$(instance_state)
info "Instance:  $(instance_id) ($(region)) — $state"
info "Dashboard: $(tf output -raw url)"

if [[ "$state" == "running" ]]; then
    # Telegram is enabled post-hoc via /etc/shellm/telegram.env, which does
    # NOT survive a rebuild — on the slack stack a missing env is worth a
    # loud reminder, on other stacks telegram only shows when installed.
    # Units are headlong-* after the rename migration and shelly-* before it;
    # a box can be on either side, and this is the first command the
    # incident runbook reaches for, so resolve the live name rather than
    # reporting a healthy service as missing.
    unit_resolver='
        u() {
            if [ -f "/etc/systemd/system/headlong-$1.service" ]; then echo "headlong-$1"
            else echo "shelly-$1"; fi
        }
        has() { [ -f "/etc/systemd/system/headlong-$1.service" ] || [ -f "/etc/systemd/system/shelly-$1.service" ]; }
    '
    telegram_check='
        if has telegram-bridge; then
            echo "telegram: $(systemctl is-active "$(u telegram-bridge)")"
        fi'
    if is_persona_stack; then
        telegram_check='
        if has telegram-bridge; then
            echo "telegram: $(systemctl is-active "$(u telegram-bridge)")"
        elif [ -f /etc/shellm/telegram.env ]; then
            echo "telegram: env present but unit missing — run deploy/scripts/update"
        else
            echo "telegram: NOT SET UP (env file is lost on rebuild) — run deploy/scripts/telegram-env, then deploy/scripts/update"
        fi'
    fi
    run_script_on_box "$unit_resolver"'
        echo "web:      $(curl -fsS localhost:8080/api/health 2>/dev/null || echo DOWN)"
        echo "service:  $(systemctl is-active "$(u web)")"
        echo "deployed: $(sudo -u shellm git -C /opt/shellm/app log -1 --oneline)"
        if has slack-bridge; then
            echo "bridge:   $(systemctl is-active "$(u slack-bridge)")"
            echo "persona:  $(systemctl is-active "$(u slack-agent)")"
        fi'"$telegram_check"'
        if [ -f /opt/shellm/app/deploy/check-deploy.sh ]; then
            # SSM runs as root; the diagnostic and its helpers belong to shellm.
            sudo -n -u shellm -- /bin/bash /opt/shellm/app/deploy/check-deploy.sh /opt/shellm/app || true
        else
            echo "Deploy configuration: checks unavailable — run deploy/scripts/update to install them."
        fi'
    echo  # box output arrives without a trailing newline (--output text strips it)
else
    info "start it with: deploy/scripts/start"
fi
